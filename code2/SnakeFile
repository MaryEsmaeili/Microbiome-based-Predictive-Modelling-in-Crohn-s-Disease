#############################################
# Snakefile — preprocessing → filtering → alpha/beta → taxa_compare
#           → DA_with_covariates → make_deltas → QC → attach_meta → ML-CV → summary
# Single-file pipeline (no external config). English comments throughout.
#############################################

import os

# ========= Global constants =========
ML_SEED     = 42
ML_N_FOLDS  = 5
SCRIPTS_DIR = "scripts"

# ========= Raw inputs (as in your repo) =========
META_XLSX         = "data/Metadata_metagenomics.xlsx"
CROHN_MERGED_TSV  = "data/utrecht_metaphlan_merged.txt"
HEALTHY_ORAL_TSV  = "data/oral_only_results_metaphlan4.txt"
HEALTHY_FECAL_TSV = "data/fecal_only_results_metaphlan4.txt"

# ========= Preprocessing outputs =========
ORAL_CROHN_OUT     = "data/processed/oral_abund_crohn.csv"
FECAL_CROHN_OUT    = "data/processed/fecal_abund_crohn.csv"
ORAL_HEALTHY_OUT   = "data/processed/oral_abund_healthy.csv"
FECAL_HEALTHY_OUT  = "data/processed/fecal_abund_healthy.csv"
MATCHED_IDS_OUT    = "data/processed/matched_sample_ids.csv"

# ========= Filtering outputs (diagnostics too) =========
ORAL_NORM_OUT          = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_NORM_OUT         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"
ORAL_HEALTHY_NORM_OUT  = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
FECAL_HEALTHY_NORM_OUT = "data/filtered/fecal_abund_healthy_filtered_normalized.csv"

FILTER_REPORT          = "results/filtering/filtering_report.txt"
FILTER_BARPNG          = "results/filtering/filtering_barplot_allgroups.png"
Z_BY_SAMPLE_PNG        = "results/filtering/zero_fraction_by_sample.png"
Z_BY_TAXON_PNG         = "results/filtering/zero_fraction_by_taxon.png"
LIBSIZE_PNG            = "results/filtering/library_size_distribution.png"
RANK_ORAL_PNG          = "results/filtering/rank_abundance_oral_combined.png"
RANK_FECAL_PNG         = "results/filtering/rank_abundance_fecal_combined.png"
PREV_ORAL_PNG          = "results/filtering/prevalence_mean_scatter_oral_combined.png"
PREV_FECAL_PNG         = "results/filtering/prevalence_mean_scatter_fecal_combined.png"

# ========= Covariates table & optional colors =========
MODEL_TABLE_POOLED     = "data/meta/model_table_pooled.csv"
CONFIG_COLORS_YAML     = "config/colors.yml"   # optional but supported by R/Py scripts

# ========= Alpha outputs (per-level helper) =========
def alpha_outputs(level):
    base = f"results/alpha_models/{level}"
    return [
        f"{base}/alpha_models_oral.csv",
        f"{base}/alpha_models_fecal.csv",
        f"{base}/paired_wilcoxon_summary.csv",
        f"{base}/boxplot_oral_Shannon_with_covariates.png",
        f"{base}/boxplot_oral_Richness_with_covariates.png",
        f"{base}/boxplot_oral_Evenness_with_covariates.png",
        f"{base}/boxplot_fecal_Shannon_with_covariates.png",
        f"{base}/boxplot_fecal_Richness_with_covariates.png",
        f"{base}/boxplot_fecal_Evenness_with_covariates.png",
        f"{base}/panel_oral_4up_with_covariates.png",
        f"{base}/panel_fecal_4up_with_covariates.png",
        f"{base}/panel_oral_4up_raw.png",
        f"{base}/panel_fecal_4up_raw.png",
    ]

# ========= Beta outputs (per-level helper) =========
def beta_outputs(level):
    base = f"results/beta_models/{level}"
    return [
        # PCoA — all groups
        f"{base}/pcoa_bray_allgroups.png",
        f"{base}/pcoa_jaccard_allgroups.png",
        f"{base}/pcoa_aitchison_allgroups.png",

        # PCoA — Crohn vs Healthy within site
        f"{base}/pcoa_bray_oral_CH.png",
        f"{base}/pcoa_bray_fecal_CH.png",

        # Paired Crohn Oral↔Fecal with lines
        f"{base}/pcoa_bray_oral_vs_fecal_paired.png",

        # PERMANOVA (with covariates)
        f"{base}/permanova_oral_bray_with_cov.csv",
        f"{base}/permanova_fecal_bray_with_cov.csv",
        f"{base}/permanova_oral_bray_with_cov_counts.csv",
        f"{base}/permanova_fecal_bray_with_cov_counts.csv",

        # PERMANOVA (no covariates)
        f"{base}/permanova_oral_bray_nocov.csv",
        f"{base}/permanova_fecal_bray_nocov.csv",
        f"{base}/permanova_oral_bray_nocov_counts.csv",
        f"{base}/permanova_fecal_bray_nocov_counts.csv",

        # Interaction disease*site (with covariates)
        f"{base}/permanova_interaction_bray.csv",
        f"{base}/permanova_interaction_bray_counts.csv",

        # PERMDISP (Bray)
        f"{base}/permdisp_oral_bray.csv",
        f"{base}/permdisp_fecal_bray.csv",
        f"{base}/permdisp_oral_bray_counts.csv",
        f"{base}/permdisp_fecal_bray_counts.csv",

        # Distance summaries
        f"{base}/beta_group_distances.csv",
        f"{base}/pairwise_oral_fecal_summary.csv",

        # Debug flag
        f"{base}/debug/done.flag",
    ]

# ========= Taxa Compare (per-rank tables & plots) =========
TAXA_OUTDIR = "results/taxa_compare"
TAXA_TOPK   = 15
RANKS       = ["genus", "species"]

_TAXA_FILES = [
    # tables
    "group_means_{rank}.csv",
    "group_deltas_{rank}.csv",
    "da_oral_CH_{rank}.csv",
    "da_fecal_CH_{rank}.csv",
    "da_paired_OC_FC_{rank}.csv",
    "ml_{rank}_tidy.csv",
    "ml_{rank}_wide_all.csv",
    "ml_{rank}_wide_topK.csv",
    "ml_{rank}_wide_clr.csv",
    # plots
    "heatmap_group_means_{rank}.png",
    "heatmap_group_deltas_{rank}.png",
    "heatmap_pairs_crohn_{rank}.png",
    "heatmap_oral_CH_unpaired_{rank}.png",
    "heatmap_fecal_CH_unpaired_{rank}.png",
    "volcano_oral_CH_{rank}.png",
    "volcano_fecal_CH_{rank}.png",
    "barplot_oral_{rank}_top{topk}.png",
    "barplot_fecal_{rank}_top{topk}.png",
]
TAXA_OUTPUTS = [
    f"{TAXA_OUTDIR}/{rank}/" + fn.format(rank=rank, topk=TAXA_TOPK)
    for rank in RANKS for fn in _TAXA_FILES
]

# ========= Downstream matrices for QC/ML =========
GENUS_WIDE_CLR   = f"{TAXA_OUTDIR}/genus/ml_genus_wide_clr.csv"
SPECIES_WIDE_CLR = f"{TAXA_OUTDIR}/species/ml_species_wide_clr.csv"

# ========= NEW: DA-with-covariates + Δ-features outputs =========
DA_OUTS = [
    "results/da/da_oral_with_covariates_genus.csv",
    "results/da/da_fecal_with_covariates_genus.csv",
    "results/da/volcano_oral_with_covariates_genus.png",
    "results/da/volcano_fecal_with_covariates_genus.png",
    "results/da/da_oral_with_covariates_species.csv",
    "results/da/da_fecal_with_covariates_species.csv",
    "results/da/volcano_oral_with_covariates_species.png",
    "results/da/volcano_fecal_with_covariates_species.png",
    # optional linear outputs (kept for completeness)
    "results/da/da_oral_with_covariates_genus_linear.csv",
    "results/da/da_fecal_with_covariates_genus_linear.csv",
    "results/da/da_oral_with_covariates_species_linear.csv",
    "results/da/da_fecal_with_covariates_species_linear.csv",
]
DELTAS_GENUS_OUT   = "results/ml/features/deltas_genus.csv"
DELTAS_SPECIES_OUT = "results/ml/features/deltas_species.csv"

# ========= QC / META / ML paths =========
QC_DIR              = "results/qc"
QC_EXCLUSION        = f"{QC_DIR}/exclusion_list.txt"
GENUS_QC_WIDE_CLR   = f"{QC_DIR}/ml_genus_wide_clr.qc.csv"
SPECIES_QC_WIDE_CLR = f"{QC_DIR}/ml_species_wide_clr.qc.csv"
QC_REPORT           = f"{QC_DIR}/qc_report.txt"

META_DIR         = "results/meta"
GENUS_WITHMETA   = f"{META_DIR}/ml_genus_wide_clr.qc.withmeta.csv"
SPECIES_WITHMETA = f"{META_DIR}/ml_species_wide_clr.qc.withmeta.csv"

ML_GENUS_DIR      = "results/ml/genus"
ML_GENUS_L1_DIR   = "results/ml/genus/l1"
ML_GENUS_RF_DIR   = "results/ml/genus/rf"
ML_GENUS_LSO_DIR  = "results/ml/genus/lso"
ML_SPECIES_DIR    = "results/ml/species"
ML_SPECIES_L1_DIR = "results/ml/species/l1"
ML_SPECIES_RF_DIR = "results/ml/species/rf"
ML_SPECIES_LSO_DIR= "results/ml/species/lso"

def ml_outputs(base):
    return [
        f"{base}/cv_scores.json",
        f"{base}/cv_predictions.csv",
        f"{base}/features_used.txt",
        f"{base}/run_meta.json",
    ]

# ========= Summary =========
MLSUM_DIR       = "results/ml_summary"
MLSUM_OVERVIEW  = f"{MLSUM_DIR}/summary_overview.csv"
MLSUM_TOPFEATS  = f"{MLSUM_DIR}/top_features.csv"
MLSUM_CONFUSION = f"{MLSUM_DIR}/confusion_matrices.csv"
MLSUM_META_JSON = f"{MLSUM_DIR}/run_meta_collated.json"

# ========= Default target =========
rule all:
    input:
        # filtering basics / diags
        ORAL_NORM_OUT, FECAL_NORM_OUT, ORAL_HEALTHY_NORM_OUT, FECAL_HEALTHY_NORM_OUT,
        FILTER_REPORT, FILTER_BARPNG, Z_BY_SAMPLE_PNG, Z_BY_TAXON_PNG, LIBSIZE_PNG,
        RANK_ORAL_PNG, RANK_FECAL_PNG, PREV_ORAL_PNG, PREV_FECAL_PNG,
        # diversity (alpha/beta)
        *alpha_outputs("genus"),
        *alpha_outputs("species"),
        *beta_outputs("genus"),
        *beta_outputs("species"),
        # taxa compare (per-rank)
        TAXA_OUTPUTS,
        # NEW: DA with covariates + deltas
        DA_OUTS,
        DELTAS_GENUS_OUT, DELTAS_SPECIES_OUT,
        # QC finals
        GENUS_QC_WIDE_CLR, SPECIES_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT,
        # meta attached
        GENUS_WITHMETA, SPECIES_WITHMETA,
        # ML outputs (genus)
        *ml_outputs(ML_GENUS_DIR),
        *ml_outputs(ML_GENUS_L1_DIR),
        *ml_outputs(ML_GENUS_RF_DIR),
        *ml_outputs(ML_GENUS_LSO_DIR),
        # ML outputs (species)
        *ml_outputs(ML_SPECIES_DIR),
        *ml_outputs(ML_SPECIES_L1_DIR),
        *ml_outputs(ML_SPECIES_RF_DIR),
        *ml_outputs(ML_SPECIES_LSO_DIR),
        # summary collated
        MLSUM_OVERVIEW, MLSUM_TOPFEATS, MLSUM_CONFUSION, MLSUM_META_JSON

# =========================================
# 1) PREPROCESSING
# =========================================
rule preprocessing:
    """Normalize sample IDs and export split abundance tables and mappings."""
    input:
        metadata      = META_XLSX,
        crohn         = CROHN_MERGED_TSV,
        healthy_oral  = HEALTHY_ORAL_TSV,
        healthy_fecal = HEALTHY_FECAL_TSV
    output:
        oral_crohn    = ORAL_CROHN_OUT,
        fecal_crohn   = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT,
        matched       = MATCHED_IDS_OUT,
        preproc_summary       = "results/preprocessing/summary.json",
        preproc_u_map         = "results/preprocessing/Utrecht_id_map_original_to_norm.tsv",
        preproc_u_collisions  = "results/preprocessing/Utrecht_id_collisions.tsv",
        preproc_ho_map        = "results/preprocessing/Healthy_oral_id_map.tsv",
        preproc_ho_collisions = "results/preprocessing/Healthy_oral_id_collisions.tsv",
        preproc_hf_map        = "results/preprocessing/Healthy_fecal_id_map.tsv",
        preproc_hf_collisions = "results/preprocessing/Healthy_fecal_id_collisions.tsv",
        preproc_sample_qc     = "results/preprocessing/sample_qc.tsv",
    script:
        f"{SCRIPTS_DIR}/preprocessing.py"

# =========================================
# 2) FILTERING
# =========================================
rule filtering:
    """Prevalence/abundance filtering + normalization; emit diagnostics."""
    input:
        oral          = ORAL_CROHN_OUT,
        fecal         = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = ORAL_HEALTHY_OUT.replace("oral_", "fecal_")
    output:
        oral_norm          = ORAL_NORM_OUT,
        fecal_norm         = FECAL_NORM_OUT,
        healthy_oral_norm  = ORAL_HEALTHY_NORM_OUT,
        healthy_fecal_norm = FECAL_HEALTHY_NORM_OUT,
        report             = FILTER_REPORT,
        barplot            = FILTER_BARPNG,
        zsample            = Z_BY_SAMPLE_PNG,
        ztaxon             = Z_BY_TAXON_PNG,
        libsize            = LIBSIZE_PNG,
        rank_oral_comb     = RANK_ORAL_PNG,
        rank_fecal_comb    = RANK_FECAL_PNG,
        prev_oral_comb     = PREV_ORAL_PNG,
        prev_fecal_comb    = PREV_FECAL_PNG
    params:
        prevalence_oral   = 0.20,
        prevalence_fecal  = 0.20,
        abundance         = 0.1,
        level             = "species",
        agg               = "mean",
        align_by_site     = True,
        mean_on_positives = False,
        pseudocount       = 1e-6,
        qc_level          = "lite",
        emit_clr          = False
    script:
        f"{SCRIPTS_DIR}/filtering.py"

# =========================================
# 3) ALPHA (per-level; uses pre-filtered abundance)
# =========================================
LEVELS = ["genus", "species"]

rule alpha_level:
    input:
        oral_crohn     = ORAL_CROHN_OUT,
        fecal_crohn    = FECAL_CROHN_OUT,
        oral_healthy   = ORAL_HEALTHY_OUT,
        fecal_healthy  = FECAL_HEALTHY_OUT,
        covars_pool    = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        alpha_script   = f"{SCRIPTS_DIR}/alpha_diversity.py"
    output:
        expand("{base}", base=alpha_outputs("{level}"))
    params:
        outdir = lambda w: f"results/alpha_models/{w.level}",
        level  = lambda w: w.level
    shell:
        r"""
        python {input.alpha_script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --oral-healthy {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covars-pool {input.covars_pool} \
          --pairs {input.pairs} \
          --colors {input.colors} \
          --outdir {params.outdir} \
          --level {params.level}
        """

rule alpha:
    input:
        expand(alpha_outputs("genus"),   level=["genus"]),
        expand(alpha_outputs("species"), level=["species"])

# =========================================
# 4) BETA (per-level; R script)
# =========================================
rule beta_level:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covariates     = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        beta_script    = f"{SCRIPTS_DIR}/beta_diversity.R"
    output:
        expand("{base}", base=beta_outputs("{level}"))
    params:
        outdir       = lambda w: f"results/beta_models/{w.level}",
        pseudocount  = 1e-6,
        permutations = 999
    shell:
        r"""
        Rscript {input.beta_script} \
          --oral-crohn    {input.oral_crohn} \
          --fecal-crohn   {input.fecal_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covariates    {input.covariates} \
          --pairs         {input.pairs} \
          --colors        {input.colors} \
          --outdir        {params.outdir} \
          --pseudocount   {params.pseudocount} \
          --permutations  {params.permutations}
        """

rule beta:
    input:
        expand(beta_outputs("genus"),   level=["genus"]),
        expand(beta_outputs("species"), level=["species"])

# =========================================
# 5) TAXA COMPARE (single Python; emits per-rank folders)
# =========================================
rule taxa_compare:
    input:
        oc     = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fc     = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        oh     = "data/filtered/oral_abund_healthy_filtered_normalized.csv",
        fh     = "data/filtered/fecal_abund_healthy_filtered_normalized.csv",
        pairs  = "data/processed/matched_sample_ids.csv",
        covars = "data/meta/model_table_pooled.csv",
        script = "scripts/taxa_compare_unified.py"
    output:
        TAXA_OUTPUTS
    params:
        outdir     = TAXA_OUTDIR,
        topk       = TAXA_TOPK,
        heat_topk  = 15,
        presence   = 0.10,
        prevalence = 0.10
    threads: 4
    shell:
        r"""
        python {input.script} \
          --oral-crohn    {input.oc} \
          --oral-healthy  {input.oh} \
          --fecal-crohn   {input.fc} \
          --fecal-healthy {input.fh} \
          --matched-ids   {input.pairs} \
          --outdir        {params.outdir} \
          --topk {params.topk} \
          --presence-pct {params.presence} \
          --prevalence {params.prevalence} \
          --heat-topk {params.heat_topk}
        """

# =========================================
# 6) Δ features from matched Crohn (Fecal − Oral) on CLR
# =========================================
rule make_deltas:
    input:
        wide_clr_genus   = GENUS_WIDE_CLR,
        wide_clr_species = SPECIES_WIDE_CLR,
        pairs            = MATCHED_IDS_OUT
    output:
        genus   = DELTAS_GENUS_OUT,
        species = DELTAS_SPECIES_OUT
    shell:
        r"""
        python {SCRIPTS_DIR}/make_deltas.py \
          --wide-clr {input.wide_clr_genus} \
          --pairs {input.pairs} \
          --rank genus \
          --out {output.genus}
        python {SCRIPTS_DIR}/make_deltas.py \
          --wide-clr {input.wide_clr_species} \
          --pairs {input.pairs} \
          --rank species \
          --out {output.species}
        """

# =========================================
# 7) DA with covariates (logistic per taxon + linear per taxon) per site
# =========================================
# =========================
# 5.5) DA with covariates
# =========================

DA_OUTDIR = "results/da"
RANKS = ["genus", "species"]
SITES = ["oral", "fecal"]

def da_py_outputs(rank, site):
    # پایتون (CLR) — خروجی‌های DA با کووارییت
    return [
        f"{DA_OUTDIR}/da_{site}_with_covariates_{rank}.csv",
        f"{DA_OUTDIR}/da_{site}_with_covariates_{rank}_linear.csv",
        f"{DA_OUTDIR}/volcano_{site}_with_covariates_{rank}.png",
        f"{DA_OUTDIR}/volcano_{site}_with_covariates_{rank}_linear.png",
    ]

def da_R_outputs(rank, site):
    # R (ANCOM-BC) — تحلیل حساسیت روی pseudo-counts
    base = f"{DA_OUTDIR}/ancombc_{site}_{rank}"
    return [f"{base}.csv", f"{base}_volcano.png"]

# ---------------- Python (CLR) ----------------
rule da_with_cov_py:
    input:
        features = lambda w: f"results/taxa_compare/{w.rank}/ml_{w.rank}_wide_clr.csv",
        meta     = MODEL_TABLE_POOLED,
        excl     = QC_EXCLUSION,
    output:
        f"{DA_OUTDIR}/da_{{site}}_with_covariates_{{rank}}.csv",
        f"{DA_OUTDIR}/da_{{site}}_with_covariates_{{rank}}_linear.csv",
        f"{DA_OUTDIR}/volcano_{{site}}_with_covariates_{{rank}}.png",
        f"{DA_OUTDIR}/volcano_{{site}}_with_covariates_{{rank}}_linear.png",
    params:
        outdir = DA_OUTDIR,
        site   = lambda w: w.site,
        rank   = lambda w: w.rank,
    threads: 2
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python scripts/da_with_covariates.py \
          --features {input.features} \
          --meta {input.meta} \
          --exclude {input.excl} \
          --site {params.site} \
          --rank {params.rank} \
          --outdir {params.outdir}
        """


# ---------------- R (ANCOM-BC) ----------------
rule da_with_cov_R:
    input:
        features = lambda w: f"results/taxa_compare/{w.rank}/ml_{w.rank}_wide_clr.csv",
        meta     = "data/meta/model_table_pooled.csv",
        excl     = "results/qc/exclusion_list.txt"
    output:
        f"results/da/ancombc_{{site}}_{{rank}}.csv",
        f"results/da/ancombc_{{site}}_{{rank}}_volcano.png",
    params:
        outbase = lambda w: f"results/da/ancombc_{w.site}_{w.rank}",
        site    = lambda w: w.site,
        rank    = lambda w: w.rank
    shell:
        r"""
        set -euo pipefail
        mkdir -p results/da
        Rscript scripts/da_with_covariates_ancombc.R \
          --features {input.features} \
          --meta {input.meta} \
          --exclude {input.excl} \
          --site {params.site} \
          --rank {params.rank} \
          --outbase {params.outbase}
        """

# ------------- جمع‌بندی (aggregate) ----------
rule da_with_cov:
    input:
        expand(da_py_outputs("{rank}", "{site}"), rank=RANKS, site=SITES),
        expand(da_R_outputs("{rank}", "{site}"),  rank=RANKS, site=SITES)

# =========================================
# 8) QC (outlier removal for ML)
# =========================================
rule qc_both:
    input:
        genus   = GENUS_WIDE_CLR,
        species = SPECIES_WIDE_CLR,
        meta    = MODEL_TABLE_POOLED,
        script  = f"{SCRIPTS_DIR}/qc_outliers.py"
    output:
        excl        = QC_EXCLUSION,
        genus_q     = GENUS_QC_WIDE_CLR,
        species_q   = SPECIES_QC_WIDE_CLR,
        report      = QC_REPORT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {QC_DIR}
        python {input.script} \
          --in-genus {input.genus} \
          --in-species {input.species} \
          --out-genus {output.genus_q} \
          --out-species {output.species_q} \
          --out-exclusion {output.excl} \
          --out-report {output.report} \
          --meta {input.meta} \
          --iqr-mult 1.5
        """

rule qc_genus:
    input: GENUS_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT
    output: f"{QC_DIR}/.genus_qc_done"
    shell: "touch {output}"

rule qc_species:
    input: SPECIES_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT
    output: f"{QC_DIR}/.species_qc_done"
    shell: "touch {output}"

# =========================================
# 9) ATTACH META
# =========================================
rule attach_meta_genus:
    input:
        wide   = GENUS_QC_WIDE_CLR,
        meta   = MODEL_TABLE_POOLED,
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        GENUS_WITHMETA
    shell:
        r"""
        set -euo pipefail
        mkdir -p {META_DIR}
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out {output} \
          --meta-cols Sample_ID,STUDY_ID,site,disease,Age,Sex,BMI,Smoking,Antibiotics_3m,PPI_use,Steroids_ongoing,Immuno_ongoing \
          --fill-na-site NA
        """

rule attach_meta_species:
    input:
        wide   = SPECIES_QC_WIDE_CLR,
        meta   = MODEL_TABLE_POOLED,
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        SPECIES_WITHMETA
    shell:
        r"""
        set -euo pipefail
        mkdir -p {META_DIR}
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out {output} \
          --meta-cols Sample_ID,STUDY_ID,site,disease,Age,Sex,BMI,Smoking,Antibiotics_3m,PPI_use,Steroids_ongoing,Immuno_ongoing \
          --fill-na-site NA
        """

# =========================================
# 10) ML — directly from withmeta (no extra fix_meta)
# =========================================
rule ml_genus:
    input:  in_csv = GENUS_WITHMETA, script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *ml_outputs(ML_GENUS_DIR)
    params: rank="genus", outdir=ML_GENUS_DIR, cvmode="stratified_kfold", nfolds=5, model="logreg"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_genus_l1:
