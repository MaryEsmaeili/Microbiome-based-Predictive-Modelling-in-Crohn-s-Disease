#############################################
# Main microbiome pipeline Snakefile
#
# Stages (in order, enforced by .done flags):
# 1) Preprocessing (build cohort matrices + matched pairs)
# 2) Merge oral-healthy (prev + HMP) for raw alpha/beta
# 3) Build pooled percent table (da_pct_all + source-map)
# 4) Filtering (per-group filtering + QC plots)
# 5) Alpha diversity (per taxonomic level)
# 6) Beta diversity (per taxonomic level, R script)
# 7) Taxa Compare (descriptive taxa comparison; AFTER Beta)
# 8) QC (PCA / densities / boxplots incl. PPI track)
# 9) Differential Abundance (unadjusted, adjusted, paired)
# 10) Machine Learning (within-site + transfer oral↔fecal)
#
# Run whole pipeline (except ML):
#   snakemake -c4
#
# ML targets:
#   snakemake ml_within
#   snakemake ml_transfer
#############################################

configfile: "config/config.yaml"

# ----------------------- Config handles -----------------------
CFG = config or {}

# Shared config
SCRIPTS_DIR  = "scripts"
COLORS_YAML  = CFG.get("colors_yaml", "config/colors.yml")

# ---- DA config ----
DA_CFG         = CFG.get("da", {})
DA_OUTDIR      = DA_CFG.get("outdir", "results/da")
DA_LEVELS      = DA_CFG.get("levels", ["species", "genus"])
DA_ALPHA       = float(DA_CFG.get("alpha", 0.05))
DA_VOLC_METRIC = DA_CFG.get("volcano_metric", "q")
DA_PREV_IDS    = DA_CFG.get("oral_healthy_prev_ids", None)
DA_DELTAS      = DA_CFG.get("deltas_csv", None)

# Pooled percent table shared by QC, DA, ML
DA_PCT_ALL     = "data/processed/da_pct_all.csv"
DA_SOURCE_MAP  = "data/processed/da_pct_all_sources.csv"

# ---- ML config ----
ML_CFG    = CFG.get("ml", {})
ML_OUTDIR = ML_CFG.get("outdir", "results/ml")
ML_LEVELS = ML_CFG.get("levels", ["species"])
SITES     = ["oral", "fecal"]
ML_TARGETS_WITHIN   = ["disease", "ppi", "responder"]
ML_TARGETS_TRANSFER = ["disease"]
# Decide which models are available
try:
    import xgboost  # noqa: F401
    _HAS_XGB_SNAKE = True
except Exception:
    _HAS_XGB_SNAKE = False

_default_models = ["logit", "svm", "rf"]
if _HAS_XGB_SNAKE:
    _default_models.append("xgb")

ML_MODELS = ML_CFG.get("models", _default_models)
ML_OUTER  = int(ML_CFG.get("outer_folds", 5))
ML_INNER  = int(ML_CFG.get("inner_folds", 4))
ML_PERM   = int(ML_CFG.get("permutations", 0))

# ----------------------- RAW INPUTS -----------------------
META_XLSX         = "data/Metadata_metagenomics.xlsx"
CROHN_MERGED_TSV  = "data/utrecht_metaphlan_merged.txt"
HEALTHY_ORAL_TSV  = "data/oral_only_results_metaphlan4.txt"   # Utrecht/prev cohort oral only
HEALTHY_FECAL_TSV = "data/fecal_only_results_metaphlan4.txt"
HMP_ORAL_RAW      = "data/HMP_oral_metaphlan_species_table.csv"
META_TABLE_POOLED = "data/meta/model_table_pooled.csv"
CROHN_META        = "data/meta/crohn_metadata.csv"
# ----------------------- PREPROCESSED OUTPUTS -----------------------
ORAL_CROHN_OUT    = "data/processed/oral_abund_crohn.csv"
FECAL_CROHN_OUT   = "data/processed/fecal_abund_crohn.csv"
ORAL_HEALTHY_OUT  = "data/processed/oral_abund_healthy.csv"
FECAL_HEALTHY_OUT = "data/processed/fecal_abund_healthy.csv"
HMP_ORAL_PREPROC  = "data/processed/hmporal.csv"
MATCHED_PAIRS_OUT = "data/processed/matched_pairs.csv"

# Helper for alpha/beta: previous + HMP oral healthy
ALPHA_ORAL_HEALTHY_MERGED = "data/processed/oral_abund_healthy_merged_for_alpha.csv"

# ----------------------- FILTERED OUTPUTS -----------------------
ORAL_NORM_OUT          = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_NORM_OUT         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"
ORAL_HEALTHY_NORM_OUT  = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
FECAL_HEALTHY_NORM_OUT = "data/filtered/fecal_abund_healthy_filtered_normalized.csv"

FILTER_REPORT   = "results/filtering/filtering_report.txt"
FILTER_BARPNG   = "results/filtering/filtering_barplot_allgroups.png"
Z_BY_SAMPLE_PNG = "results/filtering/zero_fraction_by_sample.png"
Z_BY_TAXON_PNG  = "results/filtering/zero_fraction_by_taxon.png"
LIBSIZE_PNG     = "results/filtering/library_size_distribution.png"
RANK_ORAL_PNG   = "results/filtering/rank_abundance_oral_combined.png"
RANK_FECAL_PNG  = "results/filtering/rank_abundance_fecal_combined.png"
PREV_ORAL_PNG   = "results/filtering/prevalence_mean_scatter_oral_combined.png"
PREV_FECAL_PNG  = "results/filtering/prevalence_mean_scatter_fecal_combined.png"

# Taxonomic levels used in Alpha/Beta/QC/DA
LEVELS = ["species", "genus"]

# ----------------------- DONE-FLAGS -----------------------
FLAG_PREPROC = "results/_flags/preprocessing.done"
FLAG_MERGE   = "results/_flags/merge_oral_healthy_for_alpha.done"
FLAG_PCTALL  = "results/_flags/da_pct_all.done"
FLAG_FILTER  = "results/_flags/filtering.done"
FLAG_ALPHA   = [f"results/alpha/{lvl}/.done" for lvl in LEVELS]
FLAG_BETA    = [f"results/beta/{lvl}/.done"  for lvl in LEVELS]
FLAG_TAXA    = "results/taxa_compare/.done"
FLAG_QC      = [f"results/qc/{lvl}/.done"    for lvl in LEVELS]
FLAG_DA      = [f"{DA_OUTDIR}/{lvl}/.done"   for lvl in DA_LEVELS]

# ML done-flags
ML_WITHIN_FLAGS = [
    f"{ML_OUTDIR}/within/{site}/{target}/{model}/{level}/.done"
    for site in SITES
    for target in ML_TARGETS_WITHIN
    for model in ML_MODELS
    for level in ML_LEVELS
]

# Transfer-site (oral↔fecal)
TRAIN_TEST_PAIRS = [("oral", "fecal"), ("fecal", "oral")]

ML_TRANSFER_FLAGS = [
    f"{ML_OUTDIR}/transfer/{train}_to_{test}/{model}/{level}/.done"
    for (train, test) in TRAIN_TEST_PAIRS
    for model in ML_MODELS
    for level in ML_LEVELS
]

# ----------------------- DEFAULT TARGET -----------------------
rule all:
    """
    Default target: DA (per level) + QC done flags.
    DA is last in the chain and already depends on taxa_compare, which depends on beta, etc.
    """
    input:
        FLAG_DA,
        FLAG_QC

# ----------------------- STAGE 1: PREPROCESSING -----------------------
rule preprocessing:
    """
    Build per-cohort abundance matrices + matched pairs + ID maps.
    Produces a done-flag for downstream stages.
    """
    input:
        metadata      = META_XLSX,
        crohn         = CROHN_MERGED_TSV,
        healthy_oral  = HEALTHY_ORAL_TSV,
        healthy_fecal = HEALTHY_FECAL_TSV,
        hmp_oral      = HMP_ORAL_RAW
    output:
        oral_crohn        = ORAL_CROHN_OUT,
        fecal_crohn       = FECAL_CROHN_OUT,
        healthy_oral      = ORAL_HEALTHY_OUT,
        healthy_fecal     = FECAL_HEALTHY_OUT,
        hmp_oral_out      = HMP_ORAL_PREPROC,
        matched           = MATCHED_PAIRS_OUT,
        preproc_summary   = "results/preprocessing/summary.json",
        preproc_u_map     = "results/preprocessing/utrecht_id_map.tsv",
        preproc_u_collisions = "results/preprocessing/utrecht_collisions.tsv",
        preproc_ho_map    = "results/preprocessing/healthy_oral_id_map.tsv",
        preproc_ho_collisions = "results/preprocessing/healthy_oral_collisions.tsv",
        preproc_hf_map    = "results/preprocessing/healthy_fecal_id_map.tsv",
        preproc_hf_collisions = "results/preprocessing/healthy_fecal_collisions.tsv",
        flag              = touch(FLAG_PREPROC)
    script:
        f"{SCRIPTS_DIR}/preprocessing.py"

# ---------------- STAGE 1b: merge healthy oral (prev + HMP) for raw alpha/beta ----------------
rule merge_oral_healthy_for_alpha:
    """
    Concatenate previous-only oral healthy with HMP oral
    for raw alpha/beta diversity analyses.
    """
    input:
        prev = ORAL_HEALTHY_OUT,
        hmp  = HMP_ORAL_PREPROC,
        flag = FLAG_PREPROC
    output:
        merged = ALPHA_ORAL_HEALTHY_MERGED,
        flag2  = touch(FLAG_MERGE)
    run:
        import pandas as pd, os
        os.makedirs(os.path.dirname(output.merged), exist_ok=True)
        prev = pd.read_csv(input.prev, index_col=0)
        hmp  = pd.read_csv(input.hmp,  index_col=0)
        out  = pd.concat([prev, hmp], axis=1).fillna(0.0)
        out.to_csv(output.merged)

# ---------------- STAGE 1c: pooled DA table (OC + OH + HMP + FC + FH) ----------------
rule da_build_pct_all:
    """
    Build pooled percent-abundance table (da_pct_all) and a source-map
    used by DA, QC, and ML.
    """
    input:
        oc  = ORAL_CROHN_OUT,
        oh  = ORAL_HEALTHY_OUT,
        fc  = FECAL_CROHN_OUT,
        fh  = FECAL_HEALTHY_OUT,
        hmp = HMP_ORAL_PREPROC
    output:
        pct  = DA_PCT_ALL,
        src  = DA_SOURCE_MAP,
        flag = touch(FLAG_PCTALL)
    run:
        import os, pandas as pd
        os.makedirs(os.path.dirname(output.pct), exist_ok=True)

        def _load(p):
            df = pd.read_csv(p, index_col=0)
            return df.apply(pd.to_numeric, errors="coerce")

        oc  = _load(input.oc)
        oh  = _load(input.oh)
        hmp = _load(input.hmp)
        fc  = _load(input.fc)
        fh  = _load(input.fh)

        # main pooled table
        out = pd.concat([oc, oh, hmp, fc, fh], axis=1).fillna(0.0)
        out = out.groupby(out.index).sum()
        out.to_csv(output.pct)

        # source map with fallback labels for DA/ML/QC
        rows = []
        def add_rows(cols, site, disease, cohort):
            for s in map(str, cols):
                rows.append(
                    {
                        "Sample_ID": s,
                        "site_fallback": site,
                        "disease_fallback": int(disease),
                        "cohort": cohort,
                    }
                )

        add_rows(oc.columns,  "Oral",  1, "Oral_Crohn")
        add_rows(fc.columns,  "Fecal", 1, "Fecal_Crohn")
        add_rows(oh.columns,  "Oral",  0, "Oral_Healthy_prev")
        add_rows(hmp.columns, "Oral",  0, "Oral_Healthy_HMP")
        add_rows(fh.columns,  "Fecal", 0, "Fecal_Healthy")

        src = pd.DataFrame(rows).drop_duplicates("Sample_ID")
        src.to_csv(output.src, index=False)

# ----------------------- STAGE 2: FILTERING -----------------------
rule filtering:
    """
    Apply prevalence/abundance filters per cohort (Crohn / Healthy, Oral / Fecal)
    and generate filtering QC plots.
    """
    input:
        oral           = ORAL_CROHN_OUT,
        fecal          = FECAL_CROHN_OUT,
        healthy_oral   = ORAL_HEALTHY_OUT,
        healthy_fecal  = FECAL_HEALTHY_OUT,
        hmp_oral       = HMP_ORAL_PREPROC,
        flag           = FLAG_PCTALL
    output:
        oral_norm          = ORAL_NORM_OUT,
        fecal_norm         = FECAL_NORM_OUT,
        healthy_oral_norm  = ORAL_HEALTHY_NORM_OUT,
        healthy_fecal_norm = FECAL_HEALTHY_NORM_OUT,
        report             = FILTER_REPORT,
        barplot            = FILTER_BARPNG,
        zsample            = Z_BY_SAMPLE_PNG,
        ztaxon             = Z_BY_TAXON_PNG,
        libsize            = LIBSIZE_PNG,
        rank_oral_comb     = RANK_ORAL_PNG,
        rank_fecal_comb    = RANK_FECAL_PNG,
        prev_oral_comb     = PREV_ORAL_PNG,
        prev_fecal_comb    = PREV_FECAL_PNG,
        flag2              = touch(FLAG_FILTER)
    params:
        prevalence_oral   = float(CFG.get("filtering", {}).get("prevalence_oral", 0.20)),
        prevalence_fecal  = float(CFG.get("filtering", {}).get("prevalence_fecal", 0.20)),
        abundance         = float(CFG.get("filtering", {}).get("abundance_percent_min", 0.10)),
        level             = CFG.get("filtering", {}).get("level", "species"),
        agg               = CFG.get("filtering", {}).get("agg", "mean"),
        mean_on_positives = bool(CFG.get("filtering", {}).get("mean_on_positives", False)),
        colors_yaml       = COLORS_YAML,
        include_hmp_oral  = True
    script:
        f"{SCRIPTS_DIR}/filtering.py"

# ----------------------- STAGE 3: ALPHA (per level) -----------------------
rule alpha:
    """
    Aggregate target for alpha diversity across all taxonomic levels.
    """
    input:
        [f"results/alpha/{lvl}/.done" for lvl in LEVELS]

rule alpha_level:
    """
    Run alpha_diversity.py for each level and produce a done flag.
    """
    input:
        oc        = ORAL_CROHN_OUT,
        fc        = FECAL_CROHN_OUT,
        oh_prev   = ORAL_HEALTHY_OUT,
        oh_merged = ALPHA_ORAL_HEALTHY_MERGED,
        fh        = FECAL_HEALTHY_OUT,
        covars    = META_TABLE_POOLED,
        pairs     = MATCHED_PAIRS_OUT,
        colors    = COLORS_YAML,
        flag      = FLAG_FILTER
    output:
        done = touch("results/alpha/{level}/.done")
    params:
        level = "{level}"
    shell:
        r"""
        set -euo pipefail
        mkdir -p results/alpha/{params.level}
        python {SCRIPTS_DIR}/alpha_diversity.py \
            --oral-crohn {input.oc} \
            --fecal-crohn {input.fc} \
            --oral-healthy-merged {input.oh_merged} \
            --oral-healthy-prev {input.oh_prev} \
            --fecal-healthy {input.fh} \
            --covars-pool {input.covars} \
            --pairs {input.pairs} \
            --colors {input.colors} \
            --outdir results/alpha/{params.level} \
            --level {params.level}
        """

# ----------------------- STAGE 4: BETA (per level, R) -----------------------
BETA_SCRIPT = "scripts/beta_diversity.R"

rule beta:
    """
    Aggregate target for beta diversity across all taxonomic levels.
    """
    input:
        [f"results/beta/{lvl}/.done" for lvl in LEVELS]

rule beta_level:
    """
    Run beta_diversity.R per level for main, summary, and prev-new tasks.
    """
    conda:
        "config/enviroment_r.yml"
    input:
        oc        = ORAL_CROHN_OUT,
        fc        = FECAL_CROHN_OUT,
        oh_merged = ALPHA_ORAL_HEALTHY_MERGED,
        oh_prev   = ORAL_HEALTHY_OUT,
        fh        = FECAL_HEALTHY_OUT,
        covars    = META_TABLE_POOLED,
        pairs     = MATCHED_PAIRS_OUT,
        colors    = COLORS_YAML,
        flag      = [f"results/alpha/{lvl}/.done" for lvl in LEVELS]
    output:
        done = touch("results/beta/{level}/.done")
    params:
        level        = "{level}",
        out_main     = lambda w: f"results/beta/{w.level}",
        out_sumdir   = "results/beta/summary",
        out_prev     = "results/beta/prevnew",
        permutations = 999
    log:
        "logs/beta_{level}.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.out_main}" "{params.out_sumdir}/{params.level}" "{params.out_prev}"

        Rscript "{BETA_SCRIPT}" \
          --task main \
          --oral-crohn "{input.oc}" \
          --fecal-crohn "{input.fc}" \
          --oral-healthy-merged "{input.oh_merged}" \
          --oral-healthy-prev "{input.oh_prev}" \
          --fecal-healthy "{input.fh}" \
          --covariates "{input.covars}" \
          --pairs "{input.pairs}" \
          --colors "{input.colors}" \
          --level "{params.level}" \
          --outdir "{params.out_main}" \
          --permutations "{params.permutations}"

        Rscript "{BETA_SCRIPT}" \
          --task summarize \
          --level "{params.level}" \
          --outdir "{params.out_sumdir}"

        Rscript "{BETA_SCRIPT}" \
          --task oral_prevnew \
          --oral-crohn "{input.oc}" \
          --oral-healthy-combined "{input.oh_merged}" \
          --fecal-crohn "{input.fc}" \
          --fecal-healthy "{input.fh}" \
          --outdir "{params.out_prev}" \
          --level "{params.level}"
        """

# ---------------------- STAGE 5: Taxa Compare (AFTER Beta) ----------------------
rule taxa_compare:
    """
    Taxa comparison summaries/plots (descriptive only).
    Runs AFTER Beta diversity is complete.
    """
    input:
        script    = CFG["taxa_compare"]["script"],
        oc        = CFG["inputs"]["oral_crohn"],
        oh        = CFG["inputs"]["oral_healthy"],
        fc        = CFG["inputs"]["fecal_crohn"],
        fh        = CFG["inputs"]["fecal_healthy"],
        pairs     = CFG["inputs"]["pairs_csv"],
        beta_done = [f"results/beta/{lvl}/.done" for lvl in LEVELS]
    output:
        genus_flag   = "results/taxa_compare/genus/group_means_genus.csv",
        species_flag = "results/taxa_compare/species/group_means_species.csv",
        done         = touch("results/taxa_compare/.done")
    params:
        outdir   = CFG["taxa_compare"]["outdir"],
        topk     = CFG["taxa_compare"]["topk"],
        heatk    = CFG["taxa_compare"]["heat_topk"],
        pres     = CFG["taxa_compare"]["presence_threshold"],
        minmean  = CFG["taxa_compare"]["min_mean_pct"],
        esthr    = CFG["taxa_compare"]["effect_size_threshold"],
        maxrows  = (CFG["taxa_compare"]["max_rows"] if CFG["taxa_compare"]["max_rows"] is not None else "null"),
        legacy   = ("--emit-legacy-pages"
                    if CFG["taxa_compare"]["emit_legacy_pages"] else ""),
        pairsarg = (
            f"--pairs-csv {CFG['inputs']['pairs_csv']}"
            if (CFG["inputs"]["pairs_csv"] and str(CFG["inputs"]["pairs_csv"]).lower() != "null")
            else ""
        )
    shell:
        r"""
        python "{input.script}" \
          --oral-crohn "{input.oc}" \
          --oral-healthy "{input.oh}" \
          --fecal-crohn "{input.fc}" \
          --fecal-healthy "{input.fh}" \
          --outdir "{params.outdir}" \
          --topk {params.topk} \
          --heat-topk {params.heatk} \
          --presence-threshold {params.pres} \
          --min-mean-pct {params.minmean} \
          --effect-size-threshold {params.esthr} \
          --max-rows {params.maxrows} \
          {params.legacy} \
          {params.pairsarg}
        """

# ---------------------- STAGE 6: QC (site×disease + PPI) ----------------------
QC_SCRIPT = "scripts/qc_unified.py"
QC_OUTDIR = "results/qc"

rule qc:
    """
    Aggregate target for QC; one done flag per level.
    """
    input:
        [f"{QC_OUTDIR}/{lvl}/.done" for lvl in LEVELS]

rule qc_level:
    """
    Unified QC with three modes:
      - NOCOV      (site & disease only)
      - WITHCOV    (residualized by non-target covariates)
      - PPI_WITHCOV (focus on PPI effect; default Crohn-only)
    """
    input:
        pct_all = DA_PCT_ALL,
        meta    = META_TABLE_POOLED,
        pairs   = MATCHED_PAIRS_OUT,
        flag    = FLAG_PCTALL
    output:
        nocov_png   = QC_OUTDIR + "/{level}/pca_scatter_NOCOV.png",
        withcov_png = QC_OUTDIR + "/{level}/pca_scatter_WITHCOV.png",
        ppi_png     = QC_OUTDIR + "/{level}/pca_scatter_PPI_WITHCOV.png",
        done        = touch(QC_OUTDIR + "/{level}/.done")
    params:
        outdir  = QC_OUTDIR,
        rank    = "{level}",
        prev    = float(CFG.get("qc", {}).get("prevalence", 0.20)),
        meanp   = float(CFG.get("qc", {}).get("mean_pct", 0.10)),
        cap     = int(CFG.get("qc", {}).get("cap", 30)),
        ppi_flag = ("--ppi-include-healthy"
                    if CFG.get("qc", {}).get("ppi_include_healthy", False) else "")
    log:
        "logs/qc_{level}.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}/{params.rank}"

        python "{QC_SCRIPT}" \
          --pct-all "{input.pct_all}" \
          --meta "{input.meta}" \
          --pairs "{input.pairs}" \
          --rank "{params.rank}" \
          --outdir "{params.outdir}" \
          --prevalence "{params.prev}" \
          --mean-pct "{params.meanp}" \
          --cap "{params.cap}" \
          --modes NOCOV WITHCOV PPI_WITHCOV \
          {params.ppi_flag} \
          > "{log}" 2>&1
        """

# ----------------------- STAGE 7: Differential Abundance -----------------------
DA_SCRIPT = "scripts/da_unified_module.py"

rule da:
    """
    Aggregate target for Differential Abundance (DA) across all levels.
    """
    input:
        [f"{DA_OUTDIR}/{lvl}/.done" for lvl in LEVELS]

rule da_level:
    """
    Unified DA per level (species/genus):
      - UNADJUSTED uses source-map labels only.
      - ADJUSTED uses pooled metadata.
      - Paired uses pairs/deltas if provided.
    """
    input:
        pct_all    = lambda wc: config["da"]["pct_all"],        # e.g. data/processed/da_pct_all.csv
        meta       = lambda wc: config["da"]["meta"],           # e.g. data/meta/model_table_pooled.csv
        source_map = lambda wc: config["da"]["source_map"]      # e.g. data/processed/da_pct_all_sources.csv
    output:
        done = touch(f"{DA_OUTDIR}" + "/{level}/.done")
    params:
        outdir         = DA_OUTDIR,
        level          = "{level}",
        alpha          = lambda wc: str(config["da"].get("alpha", 0.05)),
        volc_metric    = lambda wc: str(config["da"].get("volcano_metric", "q")),
        heat_topk      = lambda wc: str(config["da"].get("heat_topk", 10)),
        label_topk     = lambda wc: str(config["da"].get("label_topk", 10)),
        paired_min     = lambda wc: str(config["da"].get("paired_min_pairs", 5)),
        plot_jitter    = lambda wc: str(config["da"].get("plot_jitter", 0.0)),
        pairs_path     = lambda wc: config["da"].get("pairs", ""),
        deltas_path    = lambda wc: config["da"].get("deltas", "")
    log:
        "logs/da_{level}.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}/{params.level}"

        python "{DA_SCRIPT}" \
          --pct-all "{input.pct_all}" \
          --meta "{input.meta}" \
          --source-map "{input.source_map}" \
          --rank "{params.level}" \
          --outdir "{params.outdir}" \
          --alpha "{params.alpha}" \
          --volcano-metric "{params.volc_metric}" \
          --heat-topk "{params.heat_topk}" \
          --label-topk "{params.label_topk}" \
          --paired-min-pairs "{params.paired_min}" \
          --plot-jitter "{params.plot_jitter}" \
          --pairs "{params.pairs_path}" \
          --deltas "{params.deltas_path}" \
          > "{log}" 2>&1
        """
# ----------------------- ML: transfer (oral ↔ fecal) -----------------------
rule ml_transfer:
    """
    Aggregate target: all transfer-site ML experiments (oral→fecal and fecal→oral).
    """
    input:
        ML_TRANSFER_FLAGS

rule ml_transfer_site_model_level:
    """
    Train on one site (train_site) and test on the other (test_site).
    Only for target = disease (Crohn vs Healthy).
    """
    input:
        taxa       = DA_PCT_ALL,
        pooled_meta = META_TABLE_POOLED,
        src_map     = DA_SOURCE_MAP,
        flag        = FLAG_PCTALL
    output:
        done = touch(ML_OUTDIR + "/transfer/{train_site}_to_{test_site}/{model}/{level}/.done")
    log:
        "logs/ml_transfer_{train_site}_to_{test_site}_{model}_{level}.log"
    params:
        outdir     = ML_OUTDIR + "/transfer/{train_site}_to_{test_site}/{model}/{level}",
        train_site = "{train_site}",
        test_site  = "{test_site}",
        model      = "{model}",
        level      = "{level}",
        outer      = ML_OUTER,
        inner      = ML_INNER
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}"

        python scripts/ml/train.py transfer \
          --taxa "{input.taxa}" \
          --meta "{input.pooled_meta}" \
          --source-map "{input.src_map}" \
          --train-site "{params.train_site}" \
          --test-site "{params.test_site}" \
          --target disease \
          --model "{params.model}" \
          --rank "{params.level}" \
          --outdir "{params.outdir}" \
          --outer {params.outer} \
          --inner {params.inner} \
          --sample-id-col "Sample_ID" \
          --site-col "site_fallback" \
          --disease-col "disease_fallback" \
          > "{log}" 2>&1
        """

# ----------------------- ML: within-site -----------------------
rule ml_within:
    """
    Aggregate target: all within-site ML experiments (oral and fecal).
    """
    input:
        ML_WITHIN_FLAGS

rule ml_within_site_model_level:
    """
    Train models within each site (oral / fecal) for multiple targets:
      - disease (Crohn vs Healthy)
      - ppi      (PPI_use 0/1)
      - responder (Crohn-only responder)
    """
    input:
        taxa       = DA_PCT_ALL,
        pooled_meta = META_TABLE_POOLED,
        crohn_meta  = CROHN_META,
        src_map     = DA_SOURCE_MAP,
        flag        = FLAG_PCTALL
    output:
        done = touch(ML_OUTDIR + "/within/{site}/{target}/{model}/{level}/.done")
    log:
        "logs/ml_within_{site}_{target}_{model}_{level}.log"
    params:
        outdir = ML_OUTDIR + "/within/{site}/{target}/{model}/{level}",
        site   = "{site}",
        target = "{target}",
        model  = "{model}",
        level  = "{level}",
        outer  = ML_OUTER,
        inner  = ML_INNER,
        perm   = ML_PERM,
        # برای disease و ppi از مدل‌تیبل‌پولد، برای responder از crohn_metadata
        meta   = lambda wc: CROHN_META if wc.target == "responder" else META_TABLE_POOLED,
        # برای disease و ppi source-map لازم داریم؛ برای responder نه
        source_arg = lambda wc: f'--source-map "{DA_SOURCE_MAP}"'
                                if wc.target in ["disease", "ppi"] else ""
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}"

        python scripts/ml/train.py within \
          --taxa "{input.taxa}" \
          --meta "{params.meta}" \
          {params.source_arg} \
          --site "{params.site}" \
          --target "{params.target}" \
          --model "{params.model}" \
          --rank "{params.level}" \
          --outdir "{params.outdir}" \
          --outer {params.outer} \
          --inner {params.inner} \
          --sample-id-col "Sample_ID" \
          --site-col "site_fallback" \
          --disease-col "disease_fallback" \
          --learningcurve \
          --permutation {params.perm} \
          > "{log}" 2>&1
        """
