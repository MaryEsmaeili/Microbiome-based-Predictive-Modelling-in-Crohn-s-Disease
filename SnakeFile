# --------------------------------------------------------------------
# OPTIONAL: Sample index (not part of rule all)
# --------------------------------------------------------------------
rule build_sample_index:
    """
    Build a light sample index joining Crohn + Healthy (optional helper).
    Not included in `rule all` to avoid forcing extra dependencies.
    """
    input:
        crohn   = "data/processed/clinical_clean.csv",
        healthy = "data/meta/healthy_metadata.csv"
    output:
        "data/meta/sample_index.csv"
    shell:
        "python scripts/build_sample_index.py --crohn {input.crohn} --healthy {input.healthy} --out {output}"

# --------------------------------------------------------------------
# CROHN METADATA (core + extended) from row-oriented Excel
# --------------------------------------------------------------------
rule crohn_metadata:
    input:
        xlsx = "data/Metadata_metagenomics.xlsx"
    output:
        core     = "data/meta/crohn_metadata_core.csv",
        extended = "data/meta/crohn_metadata_extended.csv"
    shell:
        r"""
        set -euo pipefail
        python scripts/crohn_metadata.py \
          --input {input.xlsx} \
          --outdir data/meta \
          --prefix crohn_metadata
        """

# --------------------------------------------------------------------
# HEALTHY METADATA from pilot + DAG3 + MetaPhlAn headers
# --------------------------------------------------------------------
rule healthy_metadata:
    input:
        pilot   = "data/pilot_with_all_IDs_mici.csv",
        dag3    = "data/DAG3_metadata_merged_ready_v27.xlsx",
        fecal   = "data/fecal_only_results_metaphlan4.txt",
        oral    = "data/oral_only_results_metaphlan4.txt",
        links   = "data/meta/healthy_oral_links_clean.csv"
    output:
        meta = "data/meta/healthy_metadata.csv"
    shell:
        r"""
        set -euo pipefail
        python scripts/healthy_metadata.py \
          --in    {input.links} \
          --pilot {input.pilot} \
          --dag3  {input.dag3} \
          --fecal {input.fecal} \
          --oral  {input.oral} \
          --out   {output.meta} \
          --sheet 0
        """

# --------------------------------------------------------------------
# MODEL TABLE (pooled Crohn + Healthy) for multivariable models
# --------------------------------------------------------------------
rule model_table_pooled:
    input:
        crohn      = "data/meta/crohn_metadata_core.csv",
        crohn_ext  = "data/meta/crohn_metadata_extended.csv",
        healthy    = "data/meta/healthy_metadata.csv",
        script     = "scripts/build_model_table_pooled.py"
    output:
        pooled  = "data/meta/model_table_pooled.csv",
        missing = "data/meta/missing_ids_for_email.csv"
    shell:
        r"""
        python {input.script} \
          --crohn {input.crohn} \
          --crohn-extended {input.crohn_ext} \
          --healthy {input.healthy} \
          --out-pooled {output.pooled} \
          --out-missing {output.missing}
        """

# --------------------------------------------------------------------
# PREPROCESSING (metaphlan merges, matching, etc.)
# --------------------------------------------------------------------
rule preprocessing:
    input:
        metadata      = "data/Metadata_metagenomics.xlsx",
        crohn         = "data/utrecht_metaphlan_merged.txt",
        healthy_oral  = "data/oral_only_results_metaphlan4.txt",
        healthy_fecal = "data/fecal_only_results_metaphlan4.txt"
    output:
        oral_crohn    = "data/processed/oral_abund_crohn.csv",
        oral_healthy  = "data/processed/oral_abund_healthy.csv",
        fecal_healthy = "data/processed/fecal_abund_healthy.csv",
        matched       = "data/processed/matched_sample_ids.csv"
    script:
        "scripts/preprocessing.py"

# --------------------------------------------------------------------
# FILTERING (prevalence & abundance thresholds + QC plot)
# --------------------------------------------------------------------
rule filtering:
    input:
        oral          = "data/processed/oral_abund_crohn.csv",
        fecal         = "data/processed/fecal_abund_crohn.csv",
        healthy_oral  = "data/processed/oral_abund_healthy.csv",
        healthy_fecal = "data/processed/fecal_abund_healthy.csv"
    output:
        oral_norm          = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal_norm         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        healthy_oral_norm  = "data/filtered/oral_abund_healthy_filtered_normalized.csv",
        healthy_fecal_norm = "data/filtered/fecal_abund_healthy_filtered_normalized.csv",
        report             = "results/filtering/filtering_report.txt",
        barplot            = "results/filtering/filtering_barplot_allgroups.png"
    params:
        prevalence = 0.10,
        abundance  = 0.10
    script:
        "scripts/filtering.py"

