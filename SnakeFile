# ---------- Responder prediction: oral / fecal / combined (genus + species) ----------
# ---------- Inputs ----------
CROHN_META  = "data/meta/crohn_metadata_extended.csv"
ORAL_PROC   = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_PROC  = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"

rule responder_prediction:
    input:
        meta  = CROHN_META,
        oral  = ORAL_PROC,
        fecal = FECAL_PROC,
    output:
        touch("results/responder_prediction/.done")
    params:
        outdir       = "results/responder_prediction",
        min_prev     = 0.00,
        use_clr      = 1,
        pseudo       = 1e-6,
        cohort       = "intersection",
        seed         = 42,
        splits       = 5,
        rf_trees     = 1000,
        enet_c       = 1.0,
        l1_ratio     = 0.5
    shell:
        r"""
        set -euo pipefail
        python scripts/responder_prediction.py \
          --metadata {input.meta} \
          --oral {input.oral} \
          --fecal {input.fecal} \
          --outdir {params.outdir} \
          --min-prevalence {params.min_prev} \
          --use-clr {params.use_clr} \
          --pseudocount {params.pseudo} \
          --cohort {params.cohort} \
          --seed {params.seed} \
          --splits {params.splits} \
          --rf-trees {params.rf_trees} \
          --enet-C {params.enet_c} \
          --l1-ratio {params.l1_ratio}

        touch {output}
        """

# ---------------- Oral–Fecal Overlap ----------------
rule oral_fecal_overlap:
    input:
        meta  = "data/meta/crohn_metadata_extended.csv",
        oral  = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
    output:
        touch("results/oral_fecal_overlap/.done")
    params:
        outdir = "results/oral_fecal_overlap",
        pres   = 0.0   # any > 0 is considered 'present'; change if you want stricter presence
    shell:
        r"""
        python scripts/oral_fecal_overlap.py \
          --metadata {input.meta} \
          --oral {input.oral} \
          --fecal {input.fecal} \
          --outdir {params.outdir} \
          --presence-threshold {params.pres}
        touch {output}
        """
