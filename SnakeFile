rule qc_outliers:
    input:
        alpha_oral    = "results/alpha_diversity/alpha_oral.csv",
        alpha_fecal   = "results/alpha_diversity/alpha_fecal.csv",
        alpha_healthy = "results/alpha_diversity/alpha_healthy.csv",   # ⬅️ Healthy
        beta_dist     = "results/beta_diversity/beta_group_distances.csv",
        meta          = "data/processed/clinical_clean.csv"
    output:
        alpha_out   = "results/qc/outliers_alpha.csv",
        beta_out    = "results/qc/outliers_beta.csv",
        missing     = "results/qc/missing_ids.csv",
        dups        = "results/qc/duplicates.csv",
        pcoa_all    = "results/qc/pcoa_bray_allgroups_outliers_marked.png",
        beta_within = "results/qc/outliers_beta_within.csv",
        pcoa_within = "results/qc/pcoa_bray_within_groups_outliers_marked.png"
    params:
        outdir = "results/qc",
        beta_top_pct = 0.03
    shell:
        r"""
        mkdir -p {params.outdir}

        python scripts/qc_outliers.py \
          --alpha-csv {input.alpha_oral} \
          --alpha-csv {input.alpha_fecal} \
          --alpha-csv {input.alpha_healthy} \
          --beta-dist-csv {input.beta_dist} \
          --meta {input.meta} \
          --outdir {params.outdir} \
          --beta-top-pct {params.beta_top_pct} \
          --beta-within-group

        test -s {output.alpha_out}
        test -s {output.beta_out}
        test -s {output.missing}
        test -s {output.dups}
        test -s {output.pcoa_all}
        test -s {output.beta_within}
        test -s {output.pcoa_within}
        """
