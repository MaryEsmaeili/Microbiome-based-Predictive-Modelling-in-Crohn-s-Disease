#############################################
# Snakefile — preprocessing → filtering → alpha/beta → taxa_compare → QC → attach_meta → ML-CV → summary
# Single-file pipeline (no config.yaml). Clear English comments throughout.
#############################################

import os

# ========= Global constants =========
ML_SEED     = 42
ML_N_FOLDS  = 5
SCRIPTS_DIR = "scripts"

# ========= Raw inputs =========
META_XLSX         = "data/Metadata_metagenomics.xlsx"
CROHN_MERGED_TSV  = "data/utrecht_metaphlan_merged.txt"
HEALTHY_ORAL_TSV  = "data/oral_only_results_metaphlan4.txt"
HEALTHY_FECAL_TSV = "data/fecal_only_results_metaphlan4.txt"

# ========= Preprocessing outputs =========
ORAL_CROHN_OUT     = "data/processed/oral_abund_crohn.csv"
FECAL_CROHN_OUT    = "data/processed/fecal_abund_crohn.csv"
ORAL_HEALTHY_OUT   = "data/processed/oral_abund_healthy.csv"
FECAL_HEALTHY_OUT  = "data/processed/fecal_abund_healthy.csv"
MATCHED_IDS_OUT    = "data/processed/matched_sample_ids.csv"

# ========= Filtering outputs (diagnostics too) =========
ORAL_NORM_OUT          = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_NORM_OUT         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"
ORAL_HEALTHY_NORM_OUT  = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
FECAL_HEALTHY_NORM_OUT = "data/filtered/fecal_abund_healthy_filtered_normalized.csv"

FILTER_REPORT          = "results/filtering/filtering_report.txt"
FILTER_BARPNG          = "results/filtering/filtering_barplot_allgroups.png"
Z_BY_SAMPLE_PNG        = "results/filtering/zero_fraction_by_sample.png"
Z_BY_TAXON_PNG         = "results/filtering/zero_fraction_by_taxon.png"
LIBSIZE_PNG            = "results/filtering/library_size_distribution.png"
RANK_ORAL_PNG          = "results/filtering/rank_abundance_oral_combined.png"
RANK_FECAL_PNG         = "results/filtering/rank_abundance_fecal_combined.png"
PREV_ORAL_PNG          = "results/filtering/prevalence_mean_scatter_oral_combined.png"
PREV_FECAL_PNG         = "results/filtering/prevalence_mean_scatter_fecal_combined.png"

# ========= Covariates & colors =========
MODEL_TABLE_POOLED     = "data/meta/model_table_pooled.csv"
CONFIG_COLORS_YAML     = "config/colors.yml"   # optional

# ========= Alpha outputs =========
ALPHA_OUTDIR = "results/alpha_models"
ALPHA_OUTPUTS = [
    f"{ALPHA_OUTDIR}/alpha_models_oral.csv",
    f"{ALPHA_OUTDIR}/alpha_models_fecal.csv",
    f"{ALPHA_OUTDIR}/paired_wilcoxon_summary.csv",
    f"{ALPHA_OUTDIR}/boxplot_oral_Shannon_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_oral_Richness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_oral_Evenness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Shannon_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Richness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Evenness_with_covariates.png",
]

# ========= Beta outputs =========
BETA_OUTDIR = "results/beta_models"
BETA_OUTPUTS = [
    f"{BETA_OUTDIR}/pcoa_bray_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_jaccard_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_aitchison_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_bray_oral_CH.png",
    f"{BETA_OUTDIR}/pcoa_bray_fecal_CH.png",
    f"{BETA_OUTDIR}/pcoa_bray_oral_vs_fecal_paired.png",
    f"{BETA_OUTDIR}/pairwise_oral_fecal_summary.csv",
    f"{BETA_OUTDIR}/permanova_oral_bray_with_cov.csv",
    f"{BETA_OUTDIR}/permanova_fecal_bray_with_cov.csv",
    f"{BETA_OUTDIR}/permanova_interaction_bray.csv",
    f"{BETA_OUTDIR}/permdisp_oral_bray.csv",
    f"{BETA_OUTDIR}/permdisp_fecal_bray.csv",
    f"{BETA_OUTDIR}/beta_group_distances.csv",
]

# ========= Taxa Compare outputs =========
TAXA_OUTDIR = "results/taxa_compare"
TAXA_TOPK   = 15
RANKS       = ["genus", "species"]
_TAXA_FILES = [
    # tables
    "group_means_{rank}.csv",
    "group_deltas_{rank}.csv",
    "da_oral_CH_{rank}.csv",
    "da_fecal_CH_{rank}.csv",
    "da_paired_OC_FC_{rank}.csv",
    "ml_{rank}_tidy.csv",
    "ml_{rank}_wide_all.csv",
    "ml_{rank}_wide_topK.csv",
    "ml_{rank}_wide_clr.csv",
    # plots
    "heatmap_group_means_{rank}.png",
    "heatmap_group_deltas_{rank}.png",
    "heatmap_pairs_crohn_{rank}.png",
    "heatmap_pairs_healthy_{rank}.png",
    "volcano_oral_CH_{rank}.png",
    "volcano_fecal_CH_{rank}.png",
    "barplot_oral_{rank}_top{topk}.png",
    "barplot_fecal_{rank}_top{topk}.png",
]
TAXA_OUTPUTS = [
    f"{TAXA_OUTDIR}/{rank}/" + fn.format(rank=rank, topk=TAXA_TOPK)
    for rank in RANKS for fn in _TAXA_FILES
]

# ========= QC / META / ML paths =========
GENUS_WIDE_CLR   = f"{TAXA_OUTDIR}/genus/ml_genus_wide_clr.csv"
SPECIES_WIDE_CLR = f"{TAXA_OUTDIR}/species/ml_species_wide_clr.csv"

QC_DIR              = "results/qc"
QC_EXCLUSION        = f"{QC_DIR}/exclusion_list.txt"
GENUS_QC_WIDE_CLR   = f"{QC_DIR}/ml_genus_wide_clr.qc.csv"
SPECIES_QC_WIDE_CLR = f"{QC_DIR}/ml_species_wide_clr.qc.csv"
QC_REPORT           = f"{QC_DIR}/qc_report.txt"

META_DIR           = "results/meta"
GENUS_WITHMETA     = f"{META_DIR}/ml_genus_wide_clr.qc.withmeta.csv"
SPECIES_WITHMETA   = f"{META_DIR}/ml_species_wide_clr.qc.withmeta.csv"

ML_GENUS_DIR       = "results/ml/genus"
ML_GENUS_L1_DIR    = "results/ml/genus/l1"
ML_GENUS_RF_DIR    = "results/ml/genus/rf"
ML_GENUS_LSO_DIR   = "results/ml/genus/lso"

ML_SPECIES_DIR     = "results/ml/species"
ML_SPECIES_L1_DIR  = "results/ml/species/l1"
ML_SPECIES_RF_DIR  = "results/ml/species/rf"
ML_SPECIES_LSO_DIR = "results/ml/species/lso"

def ml_outputs(base):
    return [
        f"{base}/cv_scores.json",
        f"{base}/cv_predictions.csv",
        f"{base}/features_used.txt",
        f"{base}/run_meta.json",
    ]

# ========= Summary =========
MLSUM_DIR       = "results/ml_summary"
MLSUM_OVERVIEW  = f"{MLSUM_DIR}/summary_overview.csv"
MLSUM_TOPFEATS  = f"{MLSUM_DIR}/top_features.csv"
MLSUM_CONFUSION = f"{MLSUM_DIR}/confusion_matrices.csv"
MLSUM_META_JSON = f"{MLSUM_DIR}/run_meta_collated.json"

# ========= Default target =========
rule all:
    input:
        # filtering
        ORAL_NORM_OUT, FECAL_NORM_OUT, ORAL_HEALTHY_NORM_OUT, FECAL_HEALTHY_NORM_OUT,
        FILTER_REPORT, FILTER_BARPNG, Z_BY_SAMPLE_PNG, Z_BY_TAXON_PNG, LIBSIZE_PNG,
        RANK_ORAL_PNG, RANK_FECAL_PNG, PREV_ORAL_PNG, PREV_FECAL_PNG,
        # diversity
        ALPHA_OUTPUTS, BETA_OUTPUTS,
        # taxa
        TAXA_OUTPUTS,
        # QC finals
        GENUS_QC_WIDE_CLR, SPECIES_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT,
        # meta
        GENUS_WITHMETA, SPECIES_WITHMETA,
        # ML outputs (genus)
        *ml_outputs(ML_GENUS_DIR),
        *ml_outputs(ML_GENUS_L1_DIR),
        *ml_outputs(ML_GENUS_RF_DIR),
        *ml_outputs(ML_GENUS_LSO_DIR),
        # ML outputs (species)
        *ml_outputs(ML_SPECIES_DIR),
        *ml_outputs(ML_SPECIES_L1_DIR),
        *ml_outputs(ML_SPECIES_RF_DIR),
        *ml_outputs(ML_SPECIES_LSO_DIR),
        # summary
        MLSUM_OVERVIEW, MLSUM_TOPFEATS, MLSUM_CONFUSION, MLSUM_META_JSON

# =========================================
# 1) PREPROCESSING
# =========================================
rule preprocessing:
    """Normalize sample IDs and export split abundance tables and mappings."""
    input:
        metadata      = META_XLSX,
        crohn         = CROHN_MERGED_TSV,
        healthy_oral  = HEALTHY_ORAL_TSV,
        healthy_fecal = HEALTHY_FECAL_TSV
    output:
        oral_crohn    = ORAL_CROHN_OUT,
        fecal_crohn   = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT,
        matched       = MATCHED_IDS_OUT,
        preproc_summary        = "results/preprocessing/summary.json",
        preproc_u_map          = "results/preprocessing/Utrecht_id_map_original_to_norm.tsv",
        preproc_u_collisions   = "results/preprocessing/Utrecht_id_collisions.tsv",
        preproc_ho_map         = "results/preprocessing/Healthy_oral_id_map.tsv",
        preproc_ho_collisions  = "results/preprocessing/Healthy_oral_id_collisions.tsv",
        preproc_hf_map         = "results/preprocessing/Healthy_fecal_id_map.tsv",
        preproc_hf_collisions  = "results/preprocessing/Healthy_fecal_id_collisions.tsv"
    script:
        f"{SCRIPTS_DIR}/preprocessing.py"

# =========================================
# 2) FILTERING
# =========================================
rule filtering:
    """Prevalence/abundance filtering + normalization; emit diagnostics."""
    input:
        oral          = ORAL_CROHN_OUT,
        fecal         = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT
    output:
        oral_norm          = ORAL_NORM_OUT,
        fecal_norm         = FECAL_NORM_OUT,
        healthy_oral_norm  = ORAL_HEALTHY_NORM_OUT,
        healthy_fecal_norm = FECAL_HEALTHY_NORM_OUT,
        report             = FILTER_REPORT,
        barplot            = FILTER_BARPNG,
        zsample            = Z_BY_SAMPLE_PNG,
        ztaxon             = Z_BY_TAXON_PNG,
        libsize            = LIBSIZE_PNG,
        rank_oral_comb     = RANK_ORAL_PNG,
        rank_fecal_comb    = RANK_FECAL_PNG,
        prev_oral_comb     = PREV_ORAL_PNG,
        prev_fecal_comb    = PREV_FECAL_PNG
    params:
        prevalence_oral   = 0.20,
        prevalence_fecal  = 0.20,
        abundance         = 0.1,
        level             = "species",
        agg               = "mean",
        align_by_site     = True,
        mean_on_positives = False,
        pseudocount       = 1e-6,
        qc_level          = "lite",
        emit_clr          = False
    script:
        f"{SCRIPTS_DIR}/filtering.py"

# =========================================
# 3) ALPHA
# =========================================
rule alpha:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covars_pool    = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        alpha_script   = f"{SCRIPTS_DIR}/alpha_diversity.py"
    output:
        ALPHA_OUTPUTS
    params:
        outdir = ALPHA_OUTDIR
    shell:
        r"""
        python {input.alpha_script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --oral-healthy {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covars-pool {input.covars_pool} \
          --pairs {input.pairs} \
          --colors {input.colors} \
          --outdir {params.outdir}
        """

# =========================================
# 4) BETA
# =========================================
rule beta:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covariates     = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        beta_script    = f"{SCRIPTS_DIR}/beta_diversity.R"
    output:
        BETA_OUTPUTS
    params:
        outdir        = BETA_OUTDIR,
        pseudocount   = 1e-6,
        permutations  = 999
    shell:
        r"""
        Rscript {input.beta_script} \
          --oral-crohn    {input.oral_crohn} \
          --fecal-crohn   {input.fecal_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covariates    {input.covariates} \
          --pairs         {input.pairs} \
          --colors        {input.colors} \
          --outdir        {params.outdir} \
          --pseudocount   {params.pseudocount} \
          --permutations  {params.permutations}
        """

# =========================================
# 5) TAXA COMPARE
# =========================================
rule taxa_compare:
    """Generates DA tables/plots and ML-ready matrices (incl. clr)."""
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        matched_ids    = MATCHED_IDS_OUT,
        script_path    = f"{SCRIPTS_DIR}/taxa_compare_unified.py"
    output:
        TAXA_OUTPUTS
    params:
        outdir = TAXA_OUTDIR,
        topk   = TAXA_TOPK
    shell:
        r"""
        python {input.script_path} \
          --oral-crohn    {input.oral_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-crohn   {input.fecal_crohn} \
          --fecal-healthy {input.fecal_healthy} \
          --matched-ids   {input.matched_ids} \
          --outdir        {params.outdir} \
          --topk          {params.topk}
        """

# =========================================
# 6) QC (outlier removal for ML)
# =========================================
rule qc_both:
    """
    Outlier detection on genus/species ML matrices using qc_outliers.py.
    REQUIRED ARGS (per current script): 
      --in-genus --in-species [--meta]
      --out-genus --out-species
      --out-exclusion
      --out-report
      [--out-norms] [--iqr-mult]
    """
    input:
        genus   = GENUS_WIDE_CLR,
        species = SPECIES_WIDE_CLR,
        meta    = MODEL_TABLE_POOLED,
        script  = f"{SCRIPTS_DIR}/qc_outliers.py"
    output:
        excl       = QC_EXCLUSION,
        genus_qc   = GENUS_QC_WIDE_CLR,
        species_qc = SPECIES_QC_WIDE_CLR,
        report     = QC_REPORT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {QC_DIR}
        python {input.script} \
          --in-genus {input.genus} \
          --in-species {input.species} \
          --out-genus {output.genus_qc} \
          --out-species {output.species_qc} \
          --out-exclusion {output.excl} \
          --out-report {output.report} \
          --meta {input.meta} \
          --iqr-mult 1.5
        """

# convenience checkpoints (unchanged)
rule qc_genus:
    input: GENUS_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT
    output: f"{QC_DIR}/.genus_qc_done"
    shell: "touch {output}"

rule qc_species:
    input: SPECIES_QC_WIDE_CLR, QC_EXCLUSION, QC_REPORT
    output: f"{QC_DIR}/.species_qc_done"
    shell: "touch {output}"
    
# =========================================
# 7) ATTACH META
# =========================================
rule attach_meta_genus:
    """Add meta columns to genus QC matrix; fill missing Site with 'NA'."""
    input:
        wide   = GENUS_QC_WIDE_CLR,
        meta   = MODEL_TABLE_POOLED,
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        GENUS_WITHMETA
    shell:
        r"""
        set -euo pipefail
        mkdir -p {META_DIR}
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out {output} \
          --meta-cols Sample,Group,Site,Age,Sex,BMI,PPI_use,Antibiotics_3m,Smoking,Steroids_ongoing,Immuno_ongoing,batch \
          --fill-na-site NA
        """

rule attach_meta_species:
    input:
        wide   = SPECIES_QC_WIDE_CLR,
        meta   = MODEL_TABLE_POOLED,
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        SPECIES_WITHMETA
    shell:
        r"""
        set -euo pipefail
        mkdir -p {META_DIR}
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out {output} \
          --meta-cols Sample,Group,Site,Age,Sex,BMI,PPI_use,Antibiotics_3m,Smoking,Steroids_ongoing,Immuno_ongoing,batch \
          --fill-na-site NA
        """

# =========================================
# 8) META FIX (harmonize labels / optional NA drops)
# =========================================
rule fix_meta_genus:
    """
    Rename Group→disease (Crohn=1, Healthy=0), Site→site(lower), type-casts.
    Also writes a list of dropped samples if any covariate-based dropping occurs.
    """
    input:
        GENUS_WITHMETA
    output:
        fixed   = "results/meta/ml_genus_wide_clr.qc.withmeta.fixed.csv",
        dropped = "results/meta/ml_genus_dropped_samples.txt"
    script:
        "scripts/fix_meta.py"

rule fix_meta_species:
    input:
        SPECIES_WITHMETA
    output:
        fixed   = "results/meta/ml_species_wide_clr.qc.withmeta.fixed.csv",
        dropped = "results/meta/ml_species_dropped_samples.txt"
    script:
        "scripts/fix_meta.py"

# =========================================
# 9) ML — explicit rules (no dynamic f-strings)
# =========================================
# Genus: Logistic (L2)
rule ml_genus:
    input:  in_csv = "results/meta/ml_genus_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_GENUS_DIR)
    params: rank="genus", outdir=ML_GENUS_DIR, cvmode="stratified_kfold", nfolds=5, model="logreg"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Genus: L1 (lasso)
rule ml_genus_l1:
    input:  in_csv = "results/meta/ml_genus_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_GENUS_L1_DIR)
    params: rank="genus", outdir=ML_GENUS_L1_DIR, cvmode="stratified_kfold", nfolds=5, model="l1"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Genus: Random Forest
rule ml_genus_rf:
    input:  in_csv = "results/meta/ml_genus_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_GENUS_RF_DIR)
    params: rank="genus", outdir=ML_GENUS_RF_DIR, cvmode="stratified_kfold", nfolds=5, model="random_forest"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Genus: Leave-Site-Out (logreg), nfolds=2 (since you have 2 sites)
rule ml_genus_lso:
    input:  in_csv = "results/meta/ml_genus_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_GENUS_LSO_DIR)
    params: rank="genus", outdir=ML_GENUS_LSO_DIR, cvmode="leave_site_out", nfolds=2, model="logreg", groupcol="site"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --group-col {params.groupcol} \
          --model {params.model}
        """

# Species: Logistic (L2)
rule ml_species:
    input:  in_csv = "results/meta/ml_species_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_SPECIES_DIR)
    params: rank="species", outdir=ML_SPECIES_DIR, cvmode="stratified_kfold", nfolds=5, model="logreg"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Species: L1 (lasso)
rule ml_species_l1:
    input:  in_csv = "results/meta/ml_species_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_SPECIES_L1_DIR)
    params: rank="species", outdir=ML_SPECIES_L1_DIR, cvmode="stratified_kfold", nfolds=5, model="l1"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
