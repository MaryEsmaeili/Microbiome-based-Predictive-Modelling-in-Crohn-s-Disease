          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Species: Random Forest
rule ml_species_rf:
    input:  in_csv = "results/meta/ml_species_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_SPECIES_RF_DIR)
    params: rank="species", outdir=ML_SPECIES_RF_DIR, cvmode="stratified_kfold", nfolds=5, model="random_forest"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --model {params.model}
        """

# Species: Leave-Site-Out (logreg), nfolds=2
rule ml_species_lso:
    input:  in_csv = "results/meta/ml_species_wide_clr.qc.withmeta.fixed.csv",
            script = "scripts/ml_cv.py"
    output: *ml_outputs(ML_SPECIES_LSO_DIR)
    params: rank="species", outdir=ML_SPECIES_LSO_DIR, cvmode="leave_site_out", nfolds=2, model="logreg", groupcol="site"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} \
          --seed {ML_SEED} \
          --n-folds {params.nfolds} \
          --cv-mode {params.cvmode} \
          --group-col {params.groupcol} \
          --model {params.model}
        """

# =========================================
# 10) SUMMARY (collate ML results)
# =========================================
rule ml_summary:
    """
    Collates genus/species run_meta + preds into:
      - summary_overview.csv
      - top_features.csv
      - confusion_matrices.csv
      - run_meta_collated.json
    """
    input:
        g      = f"{ML_GENUS_DIR}/run_meta.json",
        s      = f"{ML_SPECIES_DIR}/run_meta.json",
        script = f"{SCRIPTS_DIR}/summarize_ml_runs.py"
    output:
        overview  = MLSUM_OVERVIEW,
        topfeats  = MLSUM_TOPFEATS,
        confusion = MLSUM_CONFUSION,
        meta_json = MLSUM_META_JSON
    params:
        outdir      = MLSUM_DIR,
        genus_dir   = ML_GENUS_DIR,
        species_dir = ML_SPECIES_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script} \
          --genus-dir {params.genus_dir} \
          --species-dir {params.species_dir} \
          --outdir {params.outdir}
        # Safety: ensure targets exist
        test -f {output.overview}  || touch {output.overview}
        test -f {output.topfeats}  || touch {output.topfeats}
        test -f {output.confusion} || touch {output.confusion}
        test -f {output.meta_json} || touch {output.meta_json}
        """
