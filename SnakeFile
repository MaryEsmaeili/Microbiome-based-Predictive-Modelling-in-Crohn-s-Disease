# Species (Top 15) + Δ(OC−FC) & Δ(OC−OH)
############################################
rule species_comparisonV2:
    input:
        oral_crohn="data/filtered/oral_abund_crohn_filtered_normalized.csv",
        oral_healthy="data/filtered/oral_abund_healthy_filtered_normalized.csv",
        fecal_crohn="data/filtered/fecal_abund_crohn_filtered_normalized.csv"
    params:
        outdir="results/species_comparisonV2"
    output:
        # per-group stacked bars + CSVs
        "results/species_comparisonV2/stackedbar_top15_oral_crohn_species.png",
        "results/species_comparisonV2/top15_oral_crohn_species.csv",
        "results/species_comparisonV2/stackedbar_top15_oral_healthy_species.png",
        "results/species_comparisonV2/top15_oral_healthy_species.csv",
        "results/species_comparisonV2/stackedbar_top15_fecal_crohn_species.png",
        "results/species_comparisonV2/top15_fecal_crohn_species.csv",
        "results/species_comparisonV2/heatmap_pairs_crohn_species.png",
        "results/species_comparisonV2/heatmap_group_contrast_species.png",
        "results/species_comparisonV2/group_means_and_deltas_species.csv",
        "results/species_comparisonV2/barplot_mean_species.png",
        "results/species_comparisonV2/means_and_mean_species.csv",
        "results/species_comparisonV2/barplot_oral_species_top15.png"   # NEW
    threads: 1
    shell:
        """
        python scripts/species_comparison_v2.py \
            {input.oral_crohn} \
            {input.oral_healthy} \
            {input.fecal_crohn} \
            {params.outdir}
        """

