#############################################
# Snakefile — end-to-end microbiome pipeline
# Stages: preprocessing → filtering → alpha/beta → taxa_compare
#         → DA_with_covariates → deltas → PPI interactions
#         → QC targeted → ML features
#############################################

import os

# ========= Global =========
SCRIPTS_DIR = "scripts"
LEVELS      = ["genus", "species"]

# ========= Raw inputs =========
META_XLSX         = "data/Metadata_metagenomics.xlsx"
CROHN_MERGED_TSV  = "data/utrecht_metaphlan_merged.txt"
HEALTHY_ORAL_TSV  = "data/oral_only_results_metaphlan4.txt"
HEALTHY_FECAL_TSV = "data/fecal_only_results_metaphlan4.txt"

# ========= Preprocessing outputs =========
ORAL_CROHN_OUT     = "data/processed/oral_abund_crohn.csv"
FECAL_CROHN_OUT    = "data/processed/fecal_abund_crohn.csv"
ORAL_HEALTHY_OUT   = "data/processed/oral_abund_healthy.csv"
FECAL_HEALTHY_OUT  = "data/processed/fecal_abund_healthy.csv"
MATCHED_IDS_OUT    = "data/processed/matched_sample_ids.csv"

# ========= Filtering outputs =========
ORAL_NORM_OUT          = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_NORM_OUT         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"
ORAL_HEALTHY_NORM_OUT  = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
FECAL_HEALTHY_NORM_OUT = "data/filtered/fecal_abund_healthy_filtered_normalized.csv"

FILTER_REPORT          = "results/filtering/filtering_report.txt"
FILTER_BARPNG          = "results/filtering/filtering_barplot_allgroups.png"
Z_BY_SAMPLE_PNG        = "results/filtering/zero_fraction_by_sample.png"
Z_BY_TAXON_PNG         = "results/filtering/zero_fraction_by_taxon.png"
LIBSIZE_PNG            = "results/filtering/library_size_distribution.png"
RANK_ORAL_PNG          = "results/filtering/rank_abundance_oral_combined.png"
RANK_FECAL_PNG         = "results/filtering/rank_abundance_fecal_combined.png"
PREV_ORAL_PNG          = "results/filtering/prevalence_mean_scatter_oral_combined.png"
PREV_FECAL_PNG         = "results/filtering/prevalence_mean_scatter_fecal_combined.png"

# ========= Covariates / colors =========
MODEL_TABLE_POOLED = "data/meta/model_table_pooled.csv"
CONFIG_COLORS_YAML = "config/colors.yml"

# ========= Taxa-compare (per-rank) =========
TAXA_OUTDIR = "results/taxa_compare"
TAXA_TOPK   = 15
_TAXA_FILES = [
    # tables
    "group_means_{rank}.csv","group_deltas_{rank}.csv",
    "pct_oral_crohn.csv","pct_oral_healthy.csv","pct_fecal_crohn.csv","pct_fecal_healthy.csv","pct_all.csv",
    # plots
    "heatmap_group_means_{rank}.png","heatmap_group_deltas_{rank}.png",
    "heatmap_pairs_crohn_{rank}.png","heatmap_pairs_crohn_{rank}_top15.png",
    "heatmap_oral_CH_unpaired_{rank}.png","heatmap_oral_CH_unpaired_{rank}_top15.png",
    "heatmap_fecal_CH_unpaired_{rank}.png","heatmap_fecal_CH_unpaired_{rank}_top15.png",
    "barplot_oral_{rank}_top{topk}.png","barplot_fecal_{rank}_top{topk}.png",
]
TAXA_CORE_OUTPUTS = [
    f"{TAXA_OUTDIR}/{rank}/" + fn.format(rank=rank, topk=TAXA_TOPK)
    for rank in LEVELS for fn in _TAXA_FILES
]

# ========= DA (per-rank) =========
DA_OUTDIR = "results/da_models"
_DA_FILES = [
    "da_oral_unadj_{rank}.csv","da_fecal_unadj_{rank}.csv","da_paired_{rank}.csv",
    "da_all_adj_{rank}.csv","da_oral_adj_{rank}.csv","da_fecal_adj_{rank}.csv",
    "volcano_oral_unadj_{rank}.png","volcano_fecal_unadj_{rank}.png",
    "volcano_all_adj_{rank}.png","volcano_oral_adj_{rank}.png","volcano_fecal_adj_{rank}.png",
]
DA_OUTPUTS = [f"{DA_OUTDIR}/{r}/" + p.format(rank=r) for r in LEVELS for p in _DA_FILES]

# ========= PPI (per-rank) =========
PPI_OUTDIR = "results/ppi_interactions"
_PPI_FILES = [
    "ppi_effects_all.csv","ppi_effects_oral.csv","ppi_effects_fecal.csv","ppi_design_counts.csv",
    "volcano_ppi_all.png","volcano_ppi_oral.png","volcano_ppi_fecal.png",
    "volcano_int_disease_ppi.png","volcano_int_disease_site.png",
]
PPI_OUTPUTS = [f"{PPI_OUTDIR}/{r}/" + p for r in LEVELS for p in _PPI_FILES]

# ========= Deltas =========
DELTAS = [f"results/deltas/deltas_{lvl}.csv" for lvl in LEVELS]

# ========= Default target =========
rule all:
    input:
        # filtering basics / diags
        ORAL_NORM_OUT, FECAL_NORM_OUT, ORAL_HEALTHY_NORM_OUT, FECAL_HEALTHY_NORM_OUT,
        FILTER_REPORT, FILTER_BARPNG, Z_BY_SAMPLE_PNG, Z_BY_TAXON_PNG, LIBSIZE_PNG,
        RANK_ORAL_PNG, RANK_FECAL_PNG, PREV_ORAL_PNG, PREV_FECAL_PNG,
        # alpha/beta
        expand("results/alpha_models/{level}/panel_fecal_4up_raw.png", level=LEVELS),
        expand("results/beta_models/{level}/debug/done.flag", level=LEVELS),
        # taxa compare, DA, deltas, PPI
        TAXA_CORE_OUTPUTS, DA_OUTPUTS, DELTAS, PPI_OUTPUTS,
        # QC targeted + ML markers
        "qc_targeted.done", "ml_features.done"

# ========== 1) PREPROCESSING ==========
rule preprocessing:
    input:
        metadata      = META_XLSX,
        crohn         = CROHN_MERGED_TSV,
        healthy_oral  = HEALTHY_ORAL_TSV,
        healthy_fecal = HEALTHY_FECAL_TSV
    output:
        oral_crohn    = ORAL_CROHN_OUT,
        fecal_crohn   = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT,
        matched       = MATCHED_IDS_OUT,
        preproc_summary       = "results/preprocessing/summary.json",
        preproc_u_map         = "results/preprocessing/Utrecht_id_map_original_to_norm.tsv",
        preproc_u_collisions  = "results/preprocessing/Utrecht_id_collisions.tsv",
        preproc_ho_map        = "results/preprocessing/Healthy_oral_id_map.tsv",
        preproc_ho_collisions = "results/preprocessing/Healthy_oral_id_collisions.tsv",
        preproc_hf_map        = "results/preprocessing/Healthy_fecal_id_map.tsv",
        preproc_hf_collisions = "results/preprocessing/Healthy_fecal_id_collisions.tsv",
        preproc_sample_qc     = "results/preprocessing/sample_qc.tsv",
    script:
        f"{SCRIPTS_DIR}/preprocessing.py"

# ========== 2) FILTERING ==========
rule filtering:
    input:
        oral          = ORAL_CROHN_OUT,
        fecal         = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT
    output:
        oral_norm          = ORAL_NORM_OUT,
        fecal_norm         = FECAL_NORM_OUT,
        healthy_oral_norm  = ORAL_HEALTHY_NORM_OUT,
        healthy_fecal_norm = FECAL_HEALTHY_NORM_OUT,
        report             = FILTER_REPORT,
        barplot            = FILTER_BARPNG,
        zsample            = Z_BY_SAMPLE_PNG,
        ztaxon             = Z_BY_TAXON_PNG,
        libsize            = LIBSIZE_PNG,
        rank_oral_comb     = RANK_ORAL_PNG,
        rank_fecal_comb    = RANK_FECAL_PNG,
        prev_oral_comb     = PREV_ORAL_PNG,
        prev_fecal_comb    = PREV_FECAL_PNG
    params:
        prevalence_oral   = 0.20,
        prevalence_fecal  = 0.20,
        abundance         = 0.1,
        level             = "species",
        agg               = "mean",
        align_by_site     = True,
        mean_on_positives = False,
        pseudocount       = 1e-6,
        qc_level          = "lite",
        emit_clr          = False
    script:
        f"{SCRIPTS_DIR}/filtering.py"

# ========== 3) ALPHA ==========
rule alpha_level:
    input:
        oral_crohn     = ORAL_CROHN_OUT,
        fecal_crohn    = FECAL_CROHN_OUT,
        oral_healthy   = ORAL_HEALTHY_OUT,
        fecal_healthy  = FECAL_HEALTHY_OUT,
        covars_pool    = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        alpha_script   = f"{SCRIPTS_DIR}/alpha_diversity.py"
    output:
        "results/alpha_models/{level}/alpha_models_oral.csv",
        "results/alpha_models/{level}/alpha_models_fecal.csv",
        "results/alpha_models/{level}/paired_wilcoxon_summary.csv",
        "results/alpha_models/{level}/boxplot_oral_Shannon_with_covariates.png",
        "results/alpha_models/{level}/boxplot_oral_Richness_with_covariates.png",
        "results/alpha_models/{level}/boxplot_oral_Evenness_with_covariates.png",
        "results/alpha_models/{level}/boxplot_fecal_Shannon_with_covariates.png",
        "results/alpha_models/{level}/boxplot_fecal_Richness_with_covariates.png",
        "results/alpha_models/{level}/boxplot_fecal_Evenness_with_covariates.png",
        "results/alpha_models/{level}/panel_oral_4up_with_covariates.png",
        "results/alpha_models/{level}/panel_fecal_4up_with_covariates.png",
        "results/alpha_models/{level}/panel_oral_4up_raw.png",
        "results/alpha_models/{level}/panel_fecal_4up_raw.png"
    params:
        outdir = lambda w: f"results/alpha_models/{w.level}",
        level  = lambda w: w.level
    shell:
        r"""
        python {input.alpha_script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --oral-healthy {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covars-pool {input.covars_pool} \
          --pairs {input.pairs} \
          --colors {input.colors} \
          --outdir {params.outdir} \
          --level {params.level}
        """

# ========== 4) BETA ==========
rule beta_level:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covariates     = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        beta_script    = f"{SCRIPTS_DIR}/beta_diversity.R"
    output:
        "results/beta_models/{level}/pcoa_bray_allgroups.png",
        "results/beta_models/{level}/pcoa_jaccard_allgroups.png",
        "results/beta_models/{level}/pcoa_aitchison_allgroups.png",
        "results/beta_models/{level}/pcoa_bray_oral_CH.png",
        "results/beta_models/{level}/pcoa_bray_fecal_CH.png",
        "results/beta_models/{level}/pcoa_bray_oral_vs_fecal_paired.png",
        "results/beta_models/{level}/permanova_oral_bray_with_cov.csv",
        "results/beta_models/{level}/permanova_fecal_bray_with_cov.csv",
        "results/beta_models/{level}/permanova_oral_bray_with_cov_counts.csv",
        "results/beta_models/{level}/permanova_fecal_bray_with_cov_counts.csv",
        "results/beta_models/{level}/permanova_oral_bray_nocov.csv",
        "results/beta_models/{level}/permanova_fecal_bray_nocov.csv",
        "results/beta_models/{level}/permanova_oral_bray_nocov_counts.csv",
        "results/beta_models/{level}/permanova_fecal_bray_nocov_counts.csv",
        "results/beta_models/{level}/permanova_interaction_bray.csv",
        "results/beta_models/{level}/permanova_interaction_bray_counts.csv",
        "results/beta_models/{level}/permdisp_oral_bray.csv",
        "results/beta_models/{level}/permdisp_fecal_bray.csv",
        "results/beta_models/{level}/permdisp_oral_bray_counts.csv",
        "results/beta_models/{level}/permdisp_fecal_bray_counts.csv",
        "results/beta_models/{level}/beta_group_distances.csv",
        "results/beta_models/{level}/pairwise_oral_fecal_summary.csv",
        "results/beta_models/{level}/debug/done.flag"
    params:
        outdir       = lambda w: f"results/beta_models/{w.level}",
        pseudocount  = 1e-6,
        permutations = 999
    shell:
        r"""
        Rscript {input.beta_script} \
          --oral-crohn    {input.oral_crohn} \
          --fecal-crohn   {input.fecal_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covariates    {input.covariates} \
          --pairs         {input.pairs} \
          --colors        {input.colors} \
          --outdir        {params.outdir} \
          --pseudocount   {params.pseudocount} \
          --permutations  {params.permutations}
        """

# ========== 5) TAXA COMPARE ==========
rule taxa_compare:
    input:
        oc     = ORAL_NORM_OUT,
        fc     = FECAL_NORM_OUT,
        oh     = ORAL_HEALTHY_NORM_OUT,
        fh     = FECAL_HEALTHY_NORM_OUT,
        script = f"{SCRIPTS_DIR}/taxa_compare_core.py"
    output:
        TAXA_CORE_OUTPUTS
    params:
        outdir     = TAXA_OUTDIR,
        topk       = TAXA_TOPK,
        heat_topk  = 15
    threads: 4
    shell:
        r"""
        python {input.script} \
          --oral-crohn    {input.oc} \
          --oral-healthy  {input.oh} \
          --fecal-crohn   {input.fc} \
          --fecal-healthy {input.fh} \
          --outdir        {params.outdir} \
          --topk          {params.topk} \
          --heat-topk     {params.heat_topk}
        """

# ========== 6) DA with covariates ==========
rule da_with_covariates_level:
    input:
        pct_all = lambda w: f"{TAXA_OUTDIR}/{w.level}/pct_all.csv",
        meta    = MODEL_TABLE_POOLED,
        pairs   = MATCHED_IDS_OUT,
        script  = f"{SCRIPTS_DIR}/da_with_covariates.py"
    output:
        f"{DA_OUTDIR}/{{level}}/da_oral_unadj_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/da_fecal_unadj_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/da_paired_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/da_all_adj_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/da_oral_adj_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/da_fecal_adj_{{level}}.csv",
        f"{DA_OUTDIR}/{{level}}/volcano_oral_unadj_{{level}}.png",
        f"{DA_OUTDIR}/{{level}}/volcano_fecal_unadj_{{level}}.png",
        f"{DA_OUTDIR}/{{level}}/volcano_all_adj_{{level}}.png",
        f"{DA_OUTDIR}/{{level}}/volcano_oral_adj_{{level}}.png",
        f"{DA_OUTDIR}/{{level}}/volcano_fecal_adj_{{level}}.png"
    params:
        outdir    = DA_OUTDIR,
        level     = lambda w: w.level,
        heat_topk = 10
    threads: 2
    shell:
        r"""
        python {input.script} \
          --pct-all {input.pct_all} \
          --meta    {input.meta} \
          --pairs   {input.pairs} \
          --rank    {params.level} \
          --outdir  {params.outdir} \
          --heat-topk {params.heat_topk}
        """

rule da_with_covariates:
    input: DA_OUTPUTS
    output: touch("da_with_covariates.done")
    shell:  r"""echo "DA complete on $(date)" > {output}"""

# ========== 7) Deltas ==========
rule make_deltas_level:
    input:
        pct_all = lambda w: f"{TAXA_OUTDIR}/{w.level}/pct_all.csv",
        pairs   = MATCHED_IDS_OUT,
        script  = f"{SCRIPTS_DIR}/make_deltas.py"
    output:
        delta = "results/deltas/deltas_{level}.csv"
    params:
        level = lambda w: w.level
    shell:
        r"""
        python {input.script} \
          --pct-all {input.pct_all} \
          --pairs   {input.pairs} \
          --rank    {params.level} \
          --out     {output.delta}
        """

rule make_deltas:
    input: DELTAS
    output: touch("make_deltas.done")
    shell:  r"""echo "Deltas complete on $(date)" > {output}"""

# ========== 8) PPI interactions ==========
rule ppi_interactions_level:
    input:
        pct_all = lambda w: f"{TAXA_OUTDIR}/{w.level}/pct_all.csv",
        meta    = MODEL_TABLE_POOLED,
        script  = f"{SCRIPTS_DIR}/ppi_interactions.py"
    output:
        f"{PPI_OUTDIR}/{{level}}/ppi_effects_all.csv",
        f"{PPI_OUTDIR}/{{level}}/ppi_effects_oral.csv",
        f"{PPI_OUTDIR}/{{level}}/ppi_effects_fecal.csv",
        f"{PPI_OUTDIR}/{{level}}/ppi_design_counts.csv",
        f"{PPI_OUTDIR}/{{level}}/volcano_ppi_all.png",
        f"{PPI_OUTDIR}/{{level}}/volcano_ppi_oral.png",
        f"{PPI_OUTDIR}/{{level}}/volcano_ppi_fecal.png",
        f"{PPI_OUTDIR}/{{level}}/volcano_int_disease_ppi.png",
        f"{PPI_OUTDIR}/{{level}}/volcano_int_disease_site.png"
    params:
        outdir         = PPI_OUTDIR,
        level          = lambda w: w.level,
        heat_topk      = 12,
        volcano_metric = "q",
        alpha          = 0.05
    shell:
        r"""
        python {input.script} \
          --pct-all {input.pct_all} \
          --meta    {input.meta} \
          --rank    {params.level} \
          --outdir  {params.outdir} \
          --heat-topk {params.heat_topk} \
          --volcano-metric {params.volcano_metric} \
          --alpha {params.alpha}
        """

rule ppi_interactions:
    input: PPI_OUTPUTS
    output: touch("ppi_interactions.done")
    shell:  r"""echo "PPI interactions finished on $(date)" > {output}"""

# ========== 9) ML features ==========
rule ml_features_level:
    input:
        pct_all = lambda w: f"{TAXA_OUTDIR}/{w.level}/pct_all.csv",
        meta    = MODEL_TABLE_POOLED,
        pairs   = MATCHED_IDS_OUT
    output:
        touch("results/ml_features/{level}/.done")
    params:
        outdir         = "results/ml_features",
        level          = lambda w: w.level,
        prevalence_min = 0.05
    shell:
        r"""
        python {SCRIPTS_DIR}/build_ml_features.py \
            --pct-all {input.pct_all} \
            --meta    {input.meta} \
            --pairs   {input.pairs} \
            --rank    {params.level} \
            --outdir  {params.outdir} \
            --prevalence-min {params.prevalence_min}
        """

rule ml_features:
    input:  expand("results/ml_features/{level}/.done", level=LEVELS)
    output: touch("ml_features.done")
    shell:  r"""echo "ML features built on $(date)" > {output}"""

# ========== 10) QC targeted ==========
rule qc_targeted_level:
    input:
        pct_all = lambda w: f"{TAXA_OUTDIR}/{w.level}/pct_all.csv",
        meta    = MODEL_TABLE_POOLED,
        ppi_all = lambda w: f"{PPI_OUTDIR}/{w.level}/ppi_effects_all.csv",
        pairs   = MATCHED_IDS_OUT
    output:
        "results/qc_targeted/{level}/top_taxa_selected.csv",
        "results/qc_targeted/{level}/box_by_ppi_oral.png",
        "results/qc_targeted/{level}/box_by_ppi_fecal.png",
        "results/qc_targeted/{level}/interaction_means.png",
        "results/qc_targeted/{level}/paired_spaghetti_crohn.png",
        "results/qc_targeted/{level}/density_top_taxa_oral.png",
        "results/qc_targeted/{level}/density_top_taxa_fecal.png"
    params:
        outdir = "results/qc_targeted",
        level  = lambda w: w.level,
        topk   = 12
    shell:
        r"""
        python {SCRIPTS_DIR}/qc_targeted.py \
            --pct-all {input.pct_all} \
            --meta    {input.meta} \
            --ppi-effects-all {input.ppi_all} \
            --pairs   {input.pairs} \
            --rank    {params.level} \
            --outdir  {params.outdir} \
            --topk    {params.topk}
            # --colors {CONFIG_COLORS_YAML}   # ← اگر qc_targeted.py از --colors پشتیبانی می‌کند، این خط را از کامنت خارج کن
        """

rule qc_targeted:
    input:  expand("results/qc_targeted/{level}/top_taxa_selected.csv", level=LEVELS)
    output: touch("qc_targeted.done")
    shell:  r"""echo "QC targeted finished on $(date)" > {output}"""
