# ------------------------------------------------------------
# ALPHA EFFECT SIZES, OUTLIERS, STABILITY (QC)
# ------------------------------------------------------------
rule alpha_effects_qc:
    input:
        alpha_oral          = "results/alpha_diversity/alpha_oral.csv",
        alpha_fecal         = "results/alpha_diversity/alpha_fecal.csv",
        alpha_healthy       = "results/alpha_diversity/alpha_healthy.csv",
        alpha_healthy_fecal = "results/alpha_diversity/alpha_healthy_fecal.csv",
        matched             = "results/alpha_diversity/alpha_matched.csv",
        paired_stats        = "results/alpha_diversity/paired_alpha_stats.csv"
    output:
        effects   = "results/alpha_diversity/alpha_effect_sizes.csv",
        outliers  = "results/alpha_diversity/alpha_outliers_iqr.csv",
        stability = "results/alpha_diversity/alpha_stability_summary.txt"
    shell:
        r"""
        set -euo pipefail
        python scripts/alpha_effects_qc.py \
          --alpha-oral {input.alpha_oral} \
          --alpha-fecal {input.alpha_fecal} \
          --alpha-healthy {input.alpha_healthy} \
          --alpha-healthy-fecal {input.alpha_healthy_fecal} \
          --matched {input.matched} \
          --paired-stats {input.paired_stats} \
          --outdir results/alpha_diversity
        """

# ------------------------------------------------------------
# BETA DIVERSITY (PCoA, PERMANOVA, PERMDISP, pairwise distances)
# ------------------------------------------------------------
rule beta_diversity:
    input:
        oral_crohn    = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal_crohn   = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        oral_healthy  = "data/filtered/oral_abund_healthy_filtered_normalized.csv",
        healthy_fecal = "data/filtered/fecal_abund_healthy_filtered_normalized.csv",
        matched_ids   = "data/processed/matched_sample_ids.csv"
    output:
        "results/beta_diversity/pcoa_bray_oral_vs_healthy.png",
        "results/beta_diversity/pcoa_jaccard_oral_vs_healthy.png",
        "results/beta_diversity/pcoa_bray_fecal_vs_healthyfecal.png",
        "results/beta_diversity/pcoa_jaccard_fecal_vs_healthyfecal.png",
        "results/beta_diversity/pcoa_bray_oral_vs_fecal.png",
        "results/beta_diversity/pcoa_jaccard_oral_vs_fecal.png",
        "results/beta_diversity/pcoa_bray_allgroups.png",
        "results/beta_diversity/pcoa_jaccard_allgroups.png",
        "results/beta_diversity/beta_group_distances.csv",
        "results/beta_diversity/beta_stats.txt",
        "results/beta_diversity/permanova_oral_CH_bray.txt",
        "results/beta_diversity/permanova_oral_CH_jaccard.txt",
        "results/beta_diversity/permanova_fecal_CH_bray.txt",
        "results/beta_diversity/permanova_fecal_CH_jaccard.txt",
        "results/beta_diversity/permanova_site_bray.txt",      # keep in sync with rule all
        "results/beta_diversity/permanova_site_jaccard.txt",
        "results/beta_diversity/permdisp_site_bray.txt",
        "results/beta_diversity/permdisp_site_jaccard.txt",
        "results/beta_diversity/pairwise_oral_fecal_distances.csv",
        "results/beta_diversity/pairwise_oral_fecal_summary.csv",
        "results/beta_diversity/pairwise_oral_fecal_violinplot.png"
    shell:
        (
            "Rscript scripts/beta_diversity.R "
            "{input.oral_crohn} {input.fecal_crohn} "
            "{input.oral_healthy} {input.healthy_fecal} "
            "{input.matched_ids} results/beta_diversity"
        )

# ------------------------------------------------------------
# Alpha models
# ------------------------------------------------------------
rule alpha_models:
    input:
        alpha_oral    = "results/alpha_diversity/alpha_oral.csv",
        alpha_fecal   = "results/alpha_diversity/alpha_fecal.csv",
        alpha_healthy = "results/alpha_diversity/alpha_healthy.csv",
        alpha_hfecal  = "results/alpha_diversity/alpha_healthy_fecal.csv",
        pooled        = "data/meta/model_table_pooled.csv",
        script        = "scripts/alpha_models.R"
    output:
        fecal_csv = "results/alpha_models/alpha_models_fecal.csv",
        oral_csv  = "results/alpha_models/alpha_models_oral.csv",
        p1 = "results/alpha_models/boxplot_fecal_Shannon_with_covariates.png",
        p2 = "results/alpha_models/boxplot_fecal_Richness_with_covariates.png",
        p3 = "results/alpha_models/boxplot_fecal_Evenness_with_covariates.png",
        p4 = "results/alpha_models/boxplot_oral_Shannon_with_covariates.png",
        p5 = "results/alpha_models/boxplot_oral_Richness_with_covariates.png",
        p6 = "results/alpha_models/boxplot_oral_Evenness_with_covariates.png"

    shell:
        r"""
        set -euo pipefail
        Rscript {input.script} \
          --alpha-oral {input.alpha_oral} \
          --alpha-fecal {input.alpha_fecal} \
          --alpha-healthy {input.alpha_healthy} \
          --alpha-healthy-fecal {input.alpha_hfecal} \
          --covariates {input.pooled} \
          --outdir results/alpha_models
        """

# ------------------------------------------------------------
# BETA Covariates
# ------------------------------------------------------------
rule beta_covariates:
    input:
        oral_crohn    = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal_crohn   = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        oral_healthy  = "data/filtered/oral_abund_healthy_filtered_normalized.csv",
        fecal_healthy = "data/filtered/fecal_abund_healthy_filtered_normalized.csv",
        covars        = "data/meta/model_table_pooled.csv",
        script        = "scripts/beta_covariates.R"
    output:
        "results/beta-covariates/pcoa_oral_bray_with_ellipses.png",
        "results/beta-covariates/pcoa_oral_aitchison_with_ellipses.png",
        "results/beta-covariates/pcoa_fecal_bray_with_ellipses.png",
        "results/beta-covariates/pcoa_fecal_aitchison_with_ellipses.png",
        "results/beta-covariates/permanova_oral_bray_with_covariates.csv",
        "results/beta-covariates/permanova_oral_aitchison_with_covariates.csv",
        "results/beta-covariates/permanova_fecal_bray_with_covariates.csv",
        "results/beta-covariates/permanova_fecal_aitchison_with_covariates.csv",
        "results/beta-covariates/permdisp_oral_bray_with_covariates.csv",
        "results/beta-covariates/permdisp_fecal_bray_with_covariates.csv"
    shell:
        r"""
        Rscript {input.script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --oral-healthy {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covariates {input.covars} \
          --outdir results/beta-covariates
        """
# ------------------------------------------------------------
# IBD within ML
# ------------------------------------------------------------
rule ibd_within_ml:
    input:
        oral_crohn="data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal_crohn="data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        covars="data/meta/model_table_pooled.csv",
        script="scripts/ibd_within_ml.py",
    output:
        touch("results/ml-ibd2/.done"),
    shell:
        r"""
        python {input.script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --covariates {input.covars} \
          --outdir results/ml-ibd2 \
          --target PPI_use \
          --min-prev 0.20 --min-prev-samples 22 \
          --max-features 500 --seed 13 \
          --outer-splits 5 --outer-repeats 20 --inner-splits 3 \
          --calibration sigmoid \
          --models elasticnet,rf \
          --add-covariates "Age,Sex,BMI" \
          --propensity-covars "Age,Sex,BMI,Antibiotics_3m" \
          --group-col Patient_ID \
          --sens-prev-samples "10,15,22" \
          --use-clr
        """
