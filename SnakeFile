rule preprocessing:
    input:
        metadata="data/Metadata_metagenomics.xlsx",
        crohn="data/utrecht_metaphlan_merged.txt",
        healthy="data/oral_only_results_metaphlan4.txt"
    output:
        oral="data/processed/oral_abund_crohn.csv",
        fecal="data/processed/fecal_abund_crohn.csv",
        healthy="data/processed/oral_abund_healthy.csv",
        matched="data/processed/matched_sample_ids.csv"
    script:
        "scripts/preprocessing.py"

rule filtering:
    input:
        oral="data/processed/oral_abund_crohn.csv",
        fecal="data/processed/fecal_abund_crohn.csv",
        healthy="data/processed/oral_abund_healthy.csv"
    output:
        oral="data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal="data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        healthy="data/filtered/oral_abund_healthy_filtered_normalized.csv",
        report="results/filtering/filtering_report.txt",
        barplot="results/filtering/filtering_barplot_allgroups.png"
    params:
        prevalence=0.2,
        abundance=0.01
    script:
        "scripts/filtering.py"

rule genus_comparison:
    input:
        oral_crohn="data/filtered/oral_abund_crohn_filtered_normalized.csv",
        oral_healthy="data/filtered/oral_abund_healthy_filtered_normalized.csv"
    params:
        outdir="results/genus_comparison"
    output:
        "results/genus_comparison/stackedbar_top10_all_oral.png",
        "results/genus_comparison/stackedbar_top10_oral_crohn.png",
        "results/genus_comparison/stackedbar_top10_oral_healthy.png",
        "results/genus_comparison/barplot_top10_oral_crohn_vs_healthy.png",
        "results/genus_comparison/top10_all_oral.csv",
        "results/genus_comparison/top10_oral_crohn.csv",
        "results/genus_comparison/top10_oral_healthy.csv",
        "results/genus_comparison/top10_compare_oral_crohn_vs_healthy.csv"
    script:
        "scripts/genus_comparison.py"

rule species_comparison:
