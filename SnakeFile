rule oral_responder_cv:
    input:
        abund = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        meta  = "data/processed/clinical_clean.csv"
    output:
        metrics_cv   = "results/oral_responder/metrics_cv.csv",
        summary      = "results/oral_responder/summary_mean_sd.csv",
        calib_lr     = "results/oral_responder/calibration_logreg.png",
        calib_rf     = "results/oral_responder/calibration_rf.png",
        pr_curve     = "results/oral_responder/pr_curve.png",
        threshold_report = "results/oral_responder/threshold_report.csv",
        cm_norm      = "results/oral_responder/cm_normalized.png",
        oof_lr       = "results/oral_responder/preds_logregL1_oof.csv",
        oof_rf       = "results/oral_responder/preds_rf_oof.csv",
        selected     = "results/oral_responder/selected_features.csv",
        coef_stab    = "results/oral_responder/coef_stability.csv",
        rf_perm_cv   = "results/oral_responder/rf_permutation_importance_cv.csv"
    params:
        outdir  = "results/oral_responder",
        level   = "species",
        repeats = 10, folds = 5, seed = 42,   # موقتاً 10×5 به‌جای 50×5
        scale   = True, vt = 1e-3, kbest = 200, n_boot = 50,
        perm_topk = 50, perm_max_folds = 6, perm_n_repeats = 5

    shell:
        r"""
        mkdir -p {params.outdir}
        SCALE_FLAG=""
        if [ "{params.scale}" = "True" ]; then SCALE_FLAG="--scale"; fi

        python scripts/oral_responder_cv.py \
          --abund {input.abund} \
          --meta {input.meta} \
          --outdir {params.outdir} \
          --level {params.level} \
          --repeats {params.repeats} \
          --folds {params.folds} \
          --seed {params.seed} \
          --vt {params.vt} \
          --kbest {params.kbest} \
          --n_boot {params.n_boot} \
          --perm-topk {params.perm_topk} \
          --perm-max-folds {params.perm_max_folds} \
          --perm-n-repeats {params.perm_n_repeats} \
        $SCALE_FLAG

        test -f {output.metrics_cv}
        test -f {output.summary}
        test -f {output.calib_lr}
        test -f {output.calib_rf}
        test -f {output.pr_curve}
        test -f {output.threshold_report}
        test -f {output.cm_norm}
        test -f {output.oof_lr}
        test -f {output.oof_rf}
        test -f {output.selected}
        test -f {output.coef_stab}
        test -f {output.rf_perm_cv}
        """

rule oral_ibd_cv:
    input:
        crohn   = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        healthy = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
    output:
        metrics_cv       = "results/oral_ibd/metrics_cv.csv",
        summary          = "results/oral_ibd/summary_mean_sd.csv",
        calib_lr         = "results/oral_ibd/calibration_logreg.png",
        calib_rf         = "results/oral_ibd/calibration_rf.png",
        pr_curve         = "results/oral_ibd/pr_curve.png",
        threshold_report = "results/oral_ibd/threshold_report.csv",
        cm_norm          = "results/oral_ibd/cm_normalized.png",
        oof_lr           = "results/oral_ibd/preds_logreg_oof.csv",
        oof_rf           = "results/oral_ibd/preds_rf_oof.csv"
    params:
        outdir  = "results/oral_ibd",
        repeats = 50, folds = 5, seed = 42,
        scale   = True,
        no_class_weight = False
    shell:
        r"""
        mkdir -p {params.outdir}
        SCALE_FLAG=""
        if [ "{params.scale}" = "True" ]; then SCALE_FLAG="--scale"; fi
        CLASSW_FLAG=""
        if [ "{params.no_class_weight}" = "True" ]; then CLASSW_FLAG="--no-class-weight"; fi

        python scripts/oral_modeling_cv.py \
          --crohn {input.crohn} \
          --healthy {input.healthy} \
          --outdir {params.outdir} \
          --repeats {params.repeats} \
          --folds {params.folds} \
          --seed {params.seed} \
          $SCALE_FLAG \
          $CLASSW_FLAG

        test -f {output.metrics_cv}
        test -f {output.summary}
        test -f {output.calib_lr}
        test -f {output.calib_rf}
        test -f {output.pr_curve}
        test -f {output.threshold_report}
        test -f {output.cm_norm}
        test -f {output.oof_lr}
        test -f {output.oof_rf}
        """

