#############################################
# Snakefile — preprocessing → filtering → alpha/beta → taxa_compare → QC → attach_meta → ML-CV → summary
# بدون config.yaml
#############################################

import os

# ========= Constants =========
ML_SEED     = 42
ML_N_FOLDS  = 5
SCRIPTS_DIR = "scripts"

# ========= Paths: raw inputs =========
META_XLSX         = "data/Metadata_metagenomics.xlsx"
CROHN_MERGED_TSV  = "data/utrecht_metaphlan_merged.txt"
HEALTHY_ORAL_TSV  = "data/oral_only_results_metaphlan4.txt"
HEALTHY_FECAL_TSV = "data/fecal_only_results_metaphlan4.txt"

# ========= Preprocessing outputs =========
ORAL_CROHN_OUT     = "data/processed/oral_abund_crohn.csv"
FECAL_CROHN_OUT    = "data/processed/fecal_abund_crohn.csv"
ORAL_HEALTHY_OUT   = "data/processed/oral_abund_healthy.csv"
FECAL_HEALTHY_OUT  = "data/processed/fecal_abund_healthy.csv"
MATCHED_IDS_OUT    = "data/processed/matched_sample_ids.csv"

# ========= Filtering outputs =========
ORAL_NORM_OUT          = "data/filtered/oral_abund_crohn_filtered_normalized.csv"
FECAL_NORM_OUT         = "data/filtered/fecal_abund_crohn_filtered_normalized.csv"
ORAL_HEALTHY_NORM_OUT  = "data/filtered/oral_abund_healthy_filtered_normalized.csv"
FECAL_HEALTHY_NORM_OUT = "data/filtered/fecal_abund_healthy_filtered_normalized.csv"

FILTER_REPORT          = "results/filtering/filtering_report.txt"
FILTER_BARPNG          = "results/filtering/filtering_barplot_allgroups.png"
Z_BY_SAMPLE_PNG        = "results/filtering/zero_fraction_by_sample.png"
Z_BY_TAXON_PNG         = "results/filtering/zero_fraction_by_taxon.png"
LIBSIZE_PNG            = "results/filtering/library_size_distribution.png"
RANK_ORAL_PNG          = "results/filtering/rank_abundance_oral_combined.png"
RANK_FECAL_PNG         = "results/filtering/rank_abundance_fecal_combined.png"
PREV_ORAL_PNG          = "results/filtering/prevalence_mean_scatter_oral_combined.png"
PREV_FECAL_PNG         = "results/filtering/prevalence_mean_scatter_fecal_combined.png"

# ========= Covariates & colors =========
MODEL_TABLE_POOLED     = "data/meta/model_table_pooled.csv"
CONFIG_COLORS_YAML     = "config/colors.yml"   # اختیاری

# ========= Alpha outputs =========
ALPHA_OUTDIR = "results/alpha_models"
ALPHA_OUTPUTS = [
    f"{ALPHA_OUTDIR}/alpha_models_oral.csv",
    f"{ALPHA_OUTDIR}/alpha_models_fecal.csv",
    f"{ALPHA_OUTDIR}/paired_wilcoxon_summary.csv",
    f"{ALPHA_OUTDIR}/boxplot_oral_Shannon_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_oral_Richness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_oral_Evenness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Shannon_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Richness_with_covariates.png",
    f"{ALPHA_OUTDIR}/boxplot_fecal_Evenness_with_covariates.png",
]

# ========= Beta outputs =========
BETA_OUTDIR = "results/beta_models"
BETA_OUTPUTS = [
    f"{BETA_OUTDIR}/pcoa_bray_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_jaccard_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_aitchison_allgroups.png",
    f"{BETA_OUTDIR}/pcoa_bray_oral_CH.png",
    f"{BETA_OUTDIR}/pcoa_bray_fecal_CH.png",
    f"{BETA_OUTDIR}/pcoa_bray_oral_vs_fecal_paired.png",
    f"{BETA_OUTDIR}/pairwise_oral_fecal_summary.csv",
    f"{BETA_OUTDIR}/permanova_oral_bray_with_cov.csv",
    f"{BETA_OUTDIR}/permanova_fecal_bray_with_cov.csv",
    f"{BETA_OUTDIR}/permanova_interaction_bray.csv",
    f"{BETA_OUTDIR}/permdisp_oral_bray.csv",
    f"{BETA_OUTDIR}/permdisp_fecal_bray.csv",
    f"{BETA_OUTDIR}/beta_group_distances.csv",
]

# ========= Taxa Compare outputs =========
TAXA_OUTDIR = "results/taxa_compare"
TAXA_TOPK   = 15
RANKS       = ["genus", "species"]
_TAXA_FILES = [
    # tables
    "group_means_{rank}.csv",
    "group_deltas_{rank}.csv",
    "da_oral_CH_{rank}.csv",
    "da_fecal_CH_{rank}.csv",
    "da_paired_OC_FC_{rank}.csv",
    "ml_{rank}_tidy.csv",
    "ml_{rank}_wide_all.csv",
    "ml_{rank}_wide_topK.csv",
    "ml_{rank}_wide_clr.csv",
    # plots
    "heatmap_group_means_{rank}.png",
    "heatmap_group_deltas_{rank}.png",
    "heatmap_pairs_crohn_{rank}.png",
    "heatmap_pairs_healthy_{rank}.png",
    "volcano_oral_CH_{rank}.png",
    "volcano_fecal_CH_{rank}.png",
    "barplot_oral_{rank}_top{topk}.png",
    "barplot_fecal_{rank}_top{topk}.png",
]
TAXA_OUTPUTS = [
    f"{TAXA_OUTDIR}/{rank}/" + fn.format(rank=rank, topk=TAXA_TOPK)
    for rank in RANKS for fn in _TAXA_FILES
]

# ========= ML / QC paths =========
QC_GENUS_DIR   = "results/ml/genus_qc"
QC_SPECIES_DIR = "results/ml/species_qc"

QC_CSV_GENUS   = f"{QC_GENUS_DIR}/ml_genus_wide_clr.qc.csv"
QC_CSV_SPECIES = f"{QC_SPECIES_DIR}/ml_species_wide_clr.qc.csv"

QC_REPORT_GENUS   = f"{QC_GENUS_DIR}/qc_report_genus.csv"
QC_META_GENUS     = f"{QC_GENUS_DIR}/qc_meta_genus.json"
QC_EXCL_GENUS     = f"{QC_GENUS_DIR}/excluded_samples_genus.txt"
QC_PLOT_GENUS     = f"{QC_GENUS_DIR}/qc_scatter_genus.png"

QC_REPORT_SPECIES = f"{QC_SPECIES_DIR}/qc_report_species.csv"
QC_META_SPECIES   = f"{QC_SPECIES_DIR}/qc_meta_species.json"
QC_EXCL_SPECIES   = f"{QC_SPECIES_DIR}/excluded_samples_species.txt"
QC_PLOT_SPECIES   = f"{QC_SPECIES_DIR}/qc_scatter_species.png"

ML_GENUS_DIR       = "results/ml/genus"
ML_GENUS_L1_DIR    = "results/ml/genus_l1"
ML_GENUS_RF_DIR    = "results/ml/genus_rf"
ML_GENUS_LSO_DIR   = "results/ml/genus_lso"

ML_SPECIES_DIR     = "results/ml/species"
ML_SPECIES_L1_DIR  = "results/ml/species_l1"
ML_SPECIES_RF_DIR  = "results/ml/species_rf"
ML_SPECIES_LSO_DIR = "results/ml/species_lso"

def RUN_FILES(outdir):
    return [
        f"{outdir}/cv_scores.json",
        f"{outdir}/cv_predictions.csv",
        f"{outdir}/features_used.txt",
        f"{outdir}/run_meta.json",
    ]

# Summary
SUMMARY_CSV   = "results/ml/summary/ml_summary.csv"
SUMMARY_JSONL = "results/ml/summary/ml_models.jsonl"

# ========= Default target =========
rule all:
    input:
        # filtering block
        ORAL_NORM_OUT, FECAL_NORM_OUT, ORAL_HEALTHY_NORM_OUT, FECAL_HEALTHY_NORM_OUT,
        FILTER_REPORT, FILTER_BARPNG, Z_BY_SAMPLE_PNG, Z_BY_TAXON_PNG, LIBSIZE_PNG,
        RANK_ORAL_PNG, RANK_FECAL_PNG, PREV_ORAL_PNG, PREV_FECAL_PNG,
        # diversity
        ALPHA_OUTPUTS, BETA_OUTPUTS,
        # taxa compare
        TAXA_OUTPUTS,
        # QC finals + artifacts
        QC_CSV_GENUS, QC_CSV_SPECIES,
        QC_REPORT_GENUS, QC_META_GENUS, QC_EXCL_GENUS, QC_PLOT_GENUS,
        QC_REPORT_SPECIES, QC_META_SPECIES, QC_EXCL_SPECIES, QC_PLOT_SPECIES,
        # ML outputs
        *RUN_FILES(ML_GENUS_DIR),
        *RUN_FILES(ML_GENUS_L1_DIR),
        *RUN_FILES(ML_GENUS_RF_DIR),
        *RUN_FILES(ML_SPECIES_DIR),
        *RUN_FILES(ML_SPECIES_L1_DIR),
        *RUN_FILES(ML_SPECIES_RF_DIR),
        # Summary
        SUMMARY_CSV, SUMMARY_JSONL

# ========= Rules =========

## -------- preprocessing --------
rule preprocessing:
    input:
        metadata      = META_XLSX,
        crohn         = CROHN_MERGED_TSV,
        healthy_oral  = HEALTHY_ORAL_TSV,
        healthy_fecal = HEALTHY_FECAL_TSV
    output:
        oral_crohn    = ORAL_CROHN_OUT,
        fecal_crohn   = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT,
        matched       = MATCHED_IDS_OUT,
        preproc_summary        = "results/preprocessing/summary.json",
        preproc_u_map          = "results/preprocessing/Utrecht_id_map_original_to_norm.tsv",
        preproc_u_collisions   = "results/preprocessing/Utrecht_id_collisions.tsv",
        preproc_ho_map         = "results/preprocessing/Healthy_oral_id_map.tsv",
        preproc_ho_collisions  = "results/preprocessing/Healthy_oral_id_collisions.tsv",
        preproc_hf_map         = "results/preprocessing/Healthy_fecal_id_map.tsv",
        preproc_hf_collisions  = "results/preprocessing/Healthy_fecal_id_collisions.tsv"
    script:
        f"{SCRIPTS_DIR}/preprocessing.py"

## -------- filtering --------
rule filtering:
    input:
        oral          = ORAL_CROHN_OUT,
        fecal         = FECAL_CROHN_OUT,
        healthy_oral  = ORAL_HEALTHY_OUT,
        healthy_fecal = FECAL_HEALTHY_OUT
    output:
        oral_norm          = ORAL_NORM_OUT,
        fecal_norm         = FECAL_NORM_OUT,
        healthy_oral_norm  = ORAL_HEALTHY_NORM_OUT,
        healthy_fecal_norm = FECAL_HEALTHY_NORM_OUT,
        report             = FILTER_REPORT,
        barplot            = FILTER_BARPNG,
        zsample            = Z_BY_SAMPLE_PNG,
        ztaxon             = Z_BY_TAXON_PNG,
        libsize            = LIBSIZE_PNG,
        rank_oral_comb     = RANK_ORAL_PNG,
        rank_fecal_comb    = RANK_FECAL_PNG,
        prev_oral_comb     = PREV_ORAL_PNG,
        prev_fecal_comb    = PREV_FECAL_PNG
    params:
        prevalence_oral   = 0.20,
        prevalence_fecal  = 0.20,
        abundance         = 0.1,
        level             = "species",
        agg               = "mean",
        align_by_site     = True,
        mean_on_positives = False,
        pseudocount       = 1e-6,
        qc_level          = "lite",
        emit_clr          = False
    script:
        f"{SCRIPTS_DIR}/filtering.py"

## -------- alpha diversity --------
rule alpha:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covars_pool    = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        alpha_script   = f"{SCRIPTS_DIR}/alpha_diversity.py"
    output:
        ALPHA_OUTPUTS
    params:
        outdir = ALPHA_OUTDIR
    shell:
        r"""
        python {input.alpha_script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --oral-healthy {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covars-pool {input.covars_pool} \
          --pairs {input.pairs} \
          --colors {input.colors} \
          --outdir {params.outdir}
        """

## -------- beta diversity --------
rule beta:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        covariates     = MODEL_TABLE_POOLED,
        pairs          = MATCHED_IDS_OUT,
        colors         = CONFIG_COLORS_YAML,
        beta_script    = f"{SCRIPTS_DIR}/beta_diversity.R"
    output:
        BETA_OUTPUTS
    params:
        outdir        = BETA_OUTDIR,
        pseudocount   = 1e-6,
        permutations  = 999
    shell:
        r"""
        Rscript {input.beta_script} \
          --oral-crohn    {input.oral_crohn} \
          --fecal-crohn   {input.fecal_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-healthy {input.fecal_healthy} \
          --covariates    {input.covariates} \
          --pairs         {input.pairs} \
          --colors        {input.colors} \
          --outdir        {params.outdir} \
          --pseudocount   {params.pseudocount} \
          --permutations  {params.permutations}
        """

## -------- taxa compare (genus/species + ML matrices + plots) --------
rule taxa_compare:
    input:
        oral_crohn     = ORAL_NORM_OUT,
        fecal_crohn    = FECAL_NORM_OUT,
        oral_healthy   = ORAL_HEALTHY_NORM_OUT,
        fecal_healthy  = FECAL_HEALTHY_NORM_OUT,
        matched_ids    = MATCHED_IDS_OUT,
        script_path    = f"{SCRIPTS_DIR}/taxa_compare_unified.py"
    output:
        TAXA_OUTPUTS
    params:
        outdir = TAXA_OUTDIR,
        topk   = TAXA_TOPK
    shell:
        r"""
        python {input.script_path} \
          --oral-crohn    {input.oral_crohn} \
          --oral-healthy  {input.oral_healthy} \
          --fecal-crohn   {input.fecal_crohn} \
          --fecal-healthy {input.fecal_healthy} \
          --matched-ids   {input.matched_ids} \
          --outdir        {params.outdir} \
          --topk          {params.topk}
        """

##############################################
# QC → attach_meta → ML (logreg/l1/rf + LSO) → summary
##############################################

# ---------- QC (genus) ----------
rule qc_genus:
    input:
        matrix_clr = f"{TAXA_OUTDIR}/genus/ml_genus_wide_clr.csv",
        matrix_all = f"{TAXA_OUTDIR}/genus/ml_genus_wide_all.csv",
        script     = f"{SCRIPTS_DIR}/qc_outliers.py"
    output:
        qc_csv   = QC_CSV_GENUS,
        report   = QC_REPORT_GENUS,
        meta     = QC_META_GENUS,
        excluded = QC_EXCL_GENUS,
        plot     = QC_PLOT_GENUS
    params:
        rank   = "genus",
        outdir = QC_GENUS_DIR
    shell:
        r"""
        set -euo pipefail
        export MPLBACKEND=Agg
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --wide-clr {input.matrix_clr} \
          --wide-all {input.matrix_all} \
          --outdir {params.outdir}
        """

# ---------- QC (species) ----------
rule qc_species:
    input:
        matrix_clr = f"{TAXA_OUTDIR}/species/ml_species_wide_clr.csv",
        matrix_all = f"{TAXA_OUTDIR}/species/ml_species_wide_all.csv",
        script     = f"{SCRIPTS_DIR}/qc_outliers.py"
    output:
        qc_csv   = QC_CSV_SPECIES,
        report   = QC_REPORT_SPECIES,
        meta     = QC_META_SPECIES,
        excluded = QC_EXCL_SPECIES,
        plot     = QC_PLOT_SPECIES
    params:
        rank   = "species",
        outdir = QC_SPECIES_DIR
    shell:
        r"""
        set -euo pipefail
        export MPLBACKEND=Agg
        mkdir -p {params.outdir}
        python {input.script} \
          --rank {params.rank} \
          --wide-clr {input.matrix_clr} \
          --wide-all {input.matrix_all} \
          --outdir {params.outdir} \
          --max-zero-frac 0.985 \
          --max-norm-z 6.0
        """
# ---------- Attach Meta (genus)
rule attach_meta_genus:
    input:
        wide   = "results/ml/genus_qc/ml_genus_wide_clr.qc.csv",
        meta   = "data/meta/model_table_pooled.csv",
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        out = "results/ml/genus_qc/ml_genus_wide_clr.qc.withmeta.csv"
    shell:
        r"""
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out  {output.out} \
          --id-col-wide Sample --id-col-meta Sample_ID \
          --group-col disease --site-col site \
          --fill-na-group Healthy --fill-na-site NA
        """

rule attach_meta_species:
    input:
        wide   = "results/ml/species_qc/ml_species_wide_clr.qc.csv",
        meta   = "data/meta/model_table_pooled.csv",
        script = f"{SCRIPTS_DIR}/attach_meta.py"
    output:
        out = "results/ml/species_qc/ml_species_wide_clr.qc.withmeta.csv"
    shell:
        r"""
        python {input.script} \
          --wide {input.wide} \
          --meta {input.meta} \
          --out  {output.out} \
          --id-col-wide Sample --id-col-meta Sample_ID \
          --group-col disease --site-col site \
          --fill-na-group Healthy --fill-na-site NA
        """

# ---------- ML (genus) ----------
rule ml_genus:
    input:  in_csv = f"{QC_GENUS_DIR}/ml_genus_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_GENUS_DIR)
    params: rank="genus", outdir=ML_GENUS_DIR, model="logreg", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_genus_l1:
    input:  in_csv = f"{QC_GENUS_DIR}/ml_genus_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_GENUS_L1_DIR)
    params: rank="genus", outdir=ML_GENUS_L1_DIR, model="l1", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_genus_rf:
    input:  in_csv = f"{QC_GENUS_DIR}/ml_genus_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_GENUS_RF_DIR)
    params: rank="genus", outdir=ML_GENUS_RF_DIR, model="rf", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_genus_lso:
    input:  in_csv = f"{QC_GENUS_DIR}/ml_genus_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_GENUS_LSO_DIR)
    params: rank="genus", outdir=ML_GENUS_LSO_DIR, model="logreg", cvmode="leave_site_out"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

# ---------- ML (species) ----------
rule ml_species:
    input:  in_csv = f"{QC_SPECIES_DIR}/ml_species_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_SPECIES_DIR)
    params: rank="species", outdir=ML_SPECIES_DIR, model="logreg", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_species_l1:
    input:  in_csv = f"{QC_SPECIES_DIR}/ml_species_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_SPECIES_L1_DIR)
    params: rank="species", outdir=ML_SPECIES_L1_DIR, model="l1", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_species_rf:
    input:  in_csv = f"{QC_SPECIES_DIR}/ml_species_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_SPECIES_RF_DIR)
    params: rank="species", outdir=ML_SPECIES_RF_DIR, model="rf", cvmode="stratified_kfold"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

rule ml_species_lso:
    input:  in_csv = f"{QC_SPECIES_DIR}/ml_species_wide_clr.qc.withmeta.csv",
            script = f"{SCRIPTS_DIR}/ml_cv.py"
    output: *RUN_FILES(ML_SPECIES_LSO_DIR)
    params: rank="species", outdir=ML_SPECIES_LSO_DIR, model="logreg", cvmode="leave_site_out"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} --rank {params.rank} --in-wide-clr {input.in_csv} \
          --outdir {params.outdir} --seed {ML_SEED} --n-folds {ML_N_FOLDS} \
          --cv-mode {params.cvmode} --model {params.model}
        """

# ---------- Summary ----------
rule ml_summary:
    input:
        script = f"{SCRIPTS_DIR}/summarize_ml_runs.py"
    output:
        csv   = SUMMARY_CSV,
        jsonl = SUMMARY_JSONL
    params:
        runs_glob = "{"
                "results/ml/genus/cv_scores.json,"
                "results/ml/genus_l1/cv_scores.json,"
                "results/ml/genus_rf/cv_scores.json,"
                "results/ml/species/cv_scores.json,"
                "results/ml/species_l1/cv_scores.json,"
                "results/ml/species_rf/cv_scores.json"
                "}",
        outdir    = "results/ml/summary"
    shell:
        r"""
        mkdir -p {params.outdir}
        python {input.script} \
          --runs-glob "{params.runs_glob}" \
          --out-csv {output.csv} \
          --out-jsonl {output.jsonl}
        """
