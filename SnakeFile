# ------------------------------
rule ml_levels:
    input:
        oral   = "data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal  = "data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        covars = "data/meta/model_table_pooled.csv",
        script = "scripts/ibd_within_ml.py"
    output:
        touch("results/ml-ibd_levels/.done")
    shell:
        r"""
        python {input.script} \
          --oral-crohn {input.oral} \
          --fecal-crohn {input.fecal} \
          --covariates {input.covars} \
          --outdir results/ml-ibd_levels \
          --target PPI_use \
          --min-prev-samples 10 \
          --models elasticnet,rf \
          --use-clr \
          --add-covariates "Age,Sex,BMI" \
          --propensity-covars "Age,Sex,BMI,Antibiotics_3m" \
          --outer-splits 5 --outer-repeats 10 --inner-splits 3 \
          --calibration sigmoid \
          --seed 13
        """

# ------------------------------------------------------------
# IBD within ML
# ------------------------------------------------------------
rule ibd_within_ml0:
    input:
        oral_crohn="data/filtered/oral_abund_crohn_filtered_normalized.csv",
        fecal_crohn="data/filtered/fecal_abund_crohn_filtered_normalized.csv",
        covars="data/meta/model_table_pooled.csv",
        script="scripts/ibd_within_ml.py",
    output:
        touch("results/ml-ibd2/.done"),
    shell:
        r"""
        python {input.script} \
          --oral-crohn {input.oral_crohn} \
          --fecal-crohn {input.fecal_crohn} \
          --covariates {input.covars} \
          --outdir results/ml-ibd2 \
          --target PPI_use \
          --min-prev 0.20 --min-prev-samples 22 \
          --max-features 500 --seed 13 \
          --outer-splits 5 --outer-repeats 20 --inner-splits 3 \
          --calibration sigmoid \
          --models elasticnet,rf \
          --add-covariates "Age,Sex,BMI" \
          --propensity-covars "Age,Sex,BMI,Antibiotics_3m" \
          --group-col Patient_ID \
          --sens-prev-samples "10,15,22" \
          --use-clr
        """


