# ------------------------------------------------------------
# Project: Oral/Fecal microbiome — Crohn vs Healthy
# Orchestrates metadata building, preprocessing, filtering,
# and analyses (alpha/beta diversity, DA at genus/species),
# plus ML runs (within-site; genus-only; species-only).
#
# Notes:
# - Python rules call CLI scripts via shell to pass arguments.
# - R rules call a single R script that writes multiple outputs.
# - Keep outputs in rule `all` synced with their rules.
# - ML package lives under scripts/ml_ibd (module path).
# ------------------------------------------------------------

configfile: "config.yaml"

SITES = ["oral", "fecal"]

