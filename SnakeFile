        "results/species_comparison/clr_da_fecal_CH_species.csv",
        "results/species_comparison/clr_da_paired_OC_FC_species.csv",
        # top-10 significant (oral)
        "results/species_comparison/top10_significant_species.csv"
    shell:
        (
            "python scripts/species_comparison.py "
